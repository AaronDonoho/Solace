   assert checkout.origin_warehouse([], customer.Domestic("CA"))
     == Error(checkout.NoWarehouse)
 }
+
+pub fn gold_customer_fixed_coupon_quote_test() {
+  let #(db, o) =
+    support.draft(seed.demo_store(), seed.grace, [#("LAMP-OAK", 1)])
+  let assert Ok(#(db, _)) =
+    checkout.apply_coupon(db, support.on_day(0), o.id, "TENOFF")
+  let assert Ok(q) = checkout.quote(db, o.id, Standard)
+  assert q.subtotal_cents == 7400
+  assert q.loyalty_discount_cents == 370
+  assert q.coupon_discount_cents == 1000
+  assert q.shipping_cents == 600
+  assert q.tax_cents == 437
+  assert q.total_cents == 7067
+}
