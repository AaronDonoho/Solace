+/// Refunded returns grouped by the month they were refunded in and reason,
+/// sorted by month then reason.
+pub fn refunds_by_month(db: Store) -> List(MonthlyRefunds) {
+  db.returns
+  |> dict.values
+  |> list.filter_map(fn(r) {
+    case r.status == return_policy.Refunded, r.refunded_at {
+      True, Some(refunded_at) -> Ok(#(r, month_of(refunded_at)))
+      _, _ -> Error(Nil)
+    }
+  })
+  |> list.group(fn(pair) {
+    #(pair.1, return_policy.reason_name({ pair.0 }.reason))
+  })
+  |> dict.to_list
+  |> list.map(fn(pair) {
+    let #(#(month, reason), rows) = pair
+    MonthlyRefunds(
+      month:,
+      reason:,
+      returns: list.length(rows),
+      refunded_cents: money.sum(
+        list.map(rows, fn(p) { { p.0 }.refund.total_cents }),
+      ),
+    )
+  })
+  |> list.sort(fn(a, b) {
+    case string.compare(a.month, b.month) {
+      ordering.Eq -> string.compare(a.reason, b.reason)
+      other -> other
+    }
+  })
+}
+
+fn month_of(ms: Int) -> String {
+  let d = date.from_unix_ms(ms)
+  string.pad_start(int.to_string(d.year), 4, "0")
+  <> "-"
+  <> string.pad_start(int.to_string(d.month), 2, "0")
+}
