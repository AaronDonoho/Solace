+
+// Consumes only the allocations covered by one shipment.
+fn subtract_allocations(
+  order_id: Int,
+  remaining: List(inventory.Allocation),
+  consumed: List(inventory.Allocation),
+) -> Result(List(inventory.Allocation), FulfillmentError) {
+  list.try_fold(
+    consumed,
+    inventory.merge_allocations(remaining),
+    fn(remaining, sent) {
+      let missing = NotAllocated(order_id, sent.warehouse_id, sent.sku)
+      case
+        list.find(remaining, fn(a) {
+          a.warehouse_id == sent.warehouse_id && a.sku == sent.sku
+        })
+      {
+        Ok(reserved) ->
+          case reserved.quantity >= sent.quantity {
+            True ->
+              Ok(
+                remaining
+                |> list.map(fn(a) {
+                  case
+                    a.warehouse_id == sent.warehouse_id && a.sku == sent.sku
+                  {
+                    True ->
+                      inventory.Allocation(
+                        a.warehouse_id,
+                        a.sku,
+                        a.quantity - sent.quantity,
+                      )
+                    False -> a
+                  }
+                })
+                |> list.filter(fn(a) { a.quantity > 0 }),
+              )
+            False -> Error(missing)
+          }
+        Error(Nil) -> Error(missing)
+      }
+    },
+  )
+}
