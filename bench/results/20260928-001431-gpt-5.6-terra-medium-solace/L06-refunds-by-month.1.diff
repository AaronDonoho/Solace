+
+pub fn refunds_by_month_test() {
+  let c = support.on_day(5)
+  let d = support.on_day(33)
+
+  let #(db, first_order, _) =
+    support.delivered(seed.demo_store(), seed.ada, [#("MUG-BLUE", 1)], 3)
+  let assert Ok(#(db, first)) =
+    returns.request(
+      db,
+      c,
+      first_order.id,
+      [Item("MUG-BLUE", 1)],
+      NoLongerNeeded,
+    )
+  assert first.refunded_at == None
+  let assert Ok(#(db, _)) = returns.approve(db, c, first.id)
+  let assert Ok(#(db, _)) = returns.receive(db, c, first.id)
+  let assert Ok(#(db, first)) =
+    returns.refund(db, c, payments.fake_gateway(), first.id)
+  assert first.refunded_at == Some(seed.epoch + 5 * seed.day)
+
+  let #(db, second_order, _) =
+    support.delivered(db, seed.ada, [#("MUG-BLUE", 1)], 3)
+  let assert Ok(#(db, second)) =
+    returns.request(db, c, second_order.id, [Item("MUG-BLUE", 1)], Damaged)
+  let assert Ok(#(db, _)) = returns.approve(db, c, second.id)
+  let assert Ok(#(db, _)) = returns.receive(db, c, second.id)
+  let assert Ok(#(db, second)) =
+    returns.refund(db, c, payments.fake_gateway(), second.id)
+
+  let #(db, third_order, _) =
+    support.delivered(db, seed.ada, [#("MUG-BLUE", 1)], 3)
+  let assert Ok(#(db, third)) =
+    returns.request(db, d, third_order.id, [Item("MUG-BLUE", 1)], Damaged)
+  let assert Ok(#(db, _)) = returns.approve(db, d, third.id)
+  let assert Ok(#(db, _)) = returns.receive(db, d, third.id)
+  let assert Ok(#(db, third)) =
+    returns.refund(db, d, payments.fake_gateway(), third.id)
+
+  assert reporting.refunds_by_month(db)
+    == [
+      MonthlyRefunds("2026-03", "damaged", 1, second.refund.total_cents),
+      MonthlyRefunds("2026-03", "no longer needed", 1, first.refund.total_cents),
+      MonthlyRefunds("2026-04", "damaged", 1, third.refund.total_cents),
+    ]
+}
