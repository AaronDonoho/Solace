   <> money.format(sum(fn(d) { d.net_cents }))
   <> "\n"
 }
+
+pub type MonthlyRefunds {
+  MonthlyRefunds(
+    month: String,
+    reason: String,
+    returns: Int,
+    refunded_cents: Int,
+  )
+}
+
+/// Refunded returns grouped by refund month and reason, sorted by month then reason.
+pub fn refunds_by_month(db: Store) -> List(MonthlyRefunds) {
+  db.returns
+  |> dict.values
+  |> list.filter(fn(r) { r.status == return_policy.Refunded })
+  |> list.filter_map(fn(r) {
+    case r.refunded_at {
+      Some(refunded_at) -> {
+        let Date(year, month, _) = date.from_unix_ms(refunded_at)
+        let month =
+          int.to_string(year)
+          <> "-"
+          <> case month < 10 {
+            True -> "0" <> int.to_string(month)
+            False -> int.to_string(month)
+          }
+        Ok(#(month, return_policy.reason_name(r.reason), r))
+      }
+      _ -> Error(Nil)
+    }
+  })
+  |> list.group(fn(r) { #(r.0, r.1) })
+  |> dict.to_list
+  |> list.map(fn(pair) {
+    MonthlyRefunds(
+      month: pair.0.0,
+      reason: pair.0.1,
+      returns: list.length(pair.1),
+      refunded_cents: money.sum(
+        list.map(pair.1, fn(r) { r.2.refund.total_cents }),
+      ),
+    )
+  })
+  |> list.sort(fn(a, b) {
+    case string.compare(a.month, b.month) {
+      ordering.Eq -> string.compare(a.reason, b.reason)
+      other -> other
+    }
+  })
+}
