   assert q.shipping_cents == 0
   assert q.tax_cents == 40
 }
+
+pub fn fixed_coupon_follows_loyalty_test() {
+  // Gold loyalty comes off $74.00 first, then TENOFF applies to $70.30.
+  let q =
+    pricing.quote(
+      [Line("LAMP-OAK", 1, 7400)],
+      Gold,
+      Some(coupon(promotions.FixedOff(1000), True)),
+      ship(600),
+      Domestic("CA"),
+    )
+  assert q.loyalty_discount_cents == 370
+  assert q.coupon_discount_cents == 1000
+  assert pricing.goods_cents(q) == 6030
+  assert q.total_cents == 7067
+}
