diff --git a/test/pilot/checkout_test.gleam b/test/pilot/checkout_test.gleam
index a9a0fa4..7fc3ff0 100644
--- a/test/pilot/checkout_test.gleam
+++ b/test/pilot/checkout_test.gleam
@@ -174,3 +174,28 @@ pub fn origin_warehouse_test() {
   assert checkout.origin_warehouse([], customer.Domestic("CA"))
     == Error(checkout.NoWarehouse)
 }
+
+pub fn category_coupon_test() {
+  let c = support.on_day(0)
+  let #(db, apparel_order) =
+    support.draft(seed.demo_store(), seed.ada, [#("TEE-M-BLK", 2)])
+  assert checkout.apply_coupon(db, c, apparel_order.id, "BOOKS20")
+    == Error(
+      CouponRejected(promotions.NotApplicable(
+        "BOOKS20",
+        "no items in the coupon category",
+      )),
+    )
+
+  let #(db, too_small) =
+    support.draft(db, seed.ada, [#("BOOK-NOVEL", 1), #("TEE-M-BLK", 2)])
+  assert checkout.apply_coupon(db, c, too_small.id, "BOOKS20")
+    == Error(CouponRejected(promotions.BelowMinimumSpend("BOOKS20", 2000)))
+
+  let #(db, order) =
+    support.draft(db, seed.ada, [#("BOOK-NOVEL", 2), #("TEE-M-BLK", 2)])
+  let assert Ok(#(db, order)) =
+    checkout.apply_coupon(db, c, order.id, "BOOKS20")
+  let assert Ok(q) = checkout.quote(db, order.id, Standard)
+  assert q.coupon_discount_cents == 480
+}
