@@ -1,9 +1,11 @@
 //// Coupons: what they discount and when they can be used.
 
+import gleam/dict.{type Dict}
 import gleam/int
 import gleam/list
 import gleam/option.{type Option, None, Some}
 import gleam/string
+import pilot/catalog
 import pilot/money
 import pilot/order.{type Line}
 
@@ -24,6 +26,8 @@ pub type Coupon {
     max_uses_per_customer: Option(Int),
     stacks_with_loyalty: Bool,
     active: Bool,
+    /// When set, the coupon applies only to lines in this category.
+    category: Option(catalog.Category),
   )
 }
 
@@ -32,6 +36,7 @@ pub type CouponContext {
   CouponContext(
     lines: List(Line),
     subtotal_cents: Int,
+    category_subtotal_cents: Int,
     now: Int,
     customer_uses: Int,
   )
@@ -63,11 +68,17 @@ pub fn validate(
     Some(max) -> context.customer_uses >= max
     None -> False
   }
+  let applicable_subtotal = case coupon.category {
+    Some(_) -> context.category_subtotal_cents
+    None -> context.subtotal_cents
+  }
   case coupon.kind {
     _ if !coupon.active -> Error(CouponInactive(code))
     _ if expired -> Error(CouponExpired(code))
     _ if used_up -> Error(UsageLimitReached(code))
-    _ if context.subtotal_cents < coupon.min_spend_cents ->
+    _ if coupon.category != None && applicable_subtotal == 0 ->
+      Error(NotApplicable(code, "no items in the coupon category"))
+    _ if applicable_subtotal < coupon.min_spend_cents ->
       Error(BelowMinimumSpend(code, coupon.min_spend_cents))
     BuyXGetY(sku:, buy:, get:) ->
       case list.find(context.lines, fn(l) { l.sku == sku }) {
@@ -117,3 +128,23 @@ pub fn describe(coupon: Coupon) -> String {
       <> " free"
   }
 }
+
+/// The total of the lines a coupon applies to. Uncategorized coupons apply
+/// to the entire order.
+pub fn applicable_subtotal(
+  coupon: Coupon,
+  lines: List(Line),
+  products: Dict(String, catalog.Product),
+) -> Int {
+  case coupon.category {
+    None -> order.subtotal_cents(lines)
+    Some(category) ->
+      list.fold(lines, 0, fn(total, line) {
+        case catalog.find_variant(products, line.sku) {
+          Ok(#(product, _)) if product.category == category ->
+            total + line.quantity * line.unit_price_cents
+          _ -> total
+        }
+      })
+  }
+}
