+
+pub fn split_shipment_lifecycle_test() {
+  let #(db, o) =
+    support.paid(seed.demo_store(), seed.ada, [#("HOOD-M-GRY", 10)])
+  let assert Ok(#(db, [east, west])) =
+    fulfillment.start_picking(db, support.on_day(1), o.id, Standard)
+  let assert Ok(#(db, east)) = fulfillment.pack(db, support.on_day(1), east.id)
+  let assert Ok(#(db, west)) = fulfillment.pack(db, support.on_day(1), west.id)
+  let assert Ok(#(db, east)) =
+    fulfillment.ship(db, support.on_day(1), payments.fake_gateway(), east.id)
+  let assert Ok(order_after_first) = store.get_order(db, o.id)
+  assert order_after_first.status == order.Picking
+  assert store.allocations_for(db, o.id)
+    == [Allocation("WH-WEST", "HOOD-M-GRY", 2)]
+  let assert Ok(payment) = store.payment_for_order(db, o.id)
+  assert payment.status == payments.Captured
+  let assert Ok(#(db, west)) =
+    fulfillment.ship(db, support.on_day(1), payments.fake_gateway(), west.id)
+  let assert Ok(order_after_last) = store.get_order(db, o.id)
+  assert order_after_last.status == order.Shipped
+  assert store.allocations_for(db, o.id) == []
+  let assert Ok(#(db, _)) = fulfillment.deliver(db, support.on_day(2), east.id)
+  let assert Ok(order_after_first_delivery) = store.get_order(db, o.id)
+  assert order_after_first_delivery.status == order.Shipped
+  let assert Ok(#(db, _)) = fulfillment.deliver(db, support.on_day(3), west.id)
+  let assert Ok(delivered_order) = store.get_order(db, o.id)
+  assert delivered_order.status == order.Delivered
+  let kinds = store.sent_messages(db) |> list.map(fn(m) { m.kind })
+  assert kinds
+    == [
+      notifications.OrderConfirmation,
+      notifications.OrderShipped,
+      notifications.OrderShipped,
+      notifications.OrderDelivered,
+    ]
+}
