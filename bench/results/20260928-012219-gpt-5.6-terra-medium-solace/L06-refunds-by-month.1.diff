index 69ae861..966404b 100644
--- a/src/pilot/reporting.gleam
+++ b/src/pilot/reporting.gleam
@@ -203,3 +203,47 @@ pub fn sales_summary(db: Store, from: Date, to: Date) -> String {
   <> money.format(sum(fn(d) { d.net_cents }))
   <> "\n"
 }
+
+pub type MonthlyRefunds {
+  MonthlyRefunds(
+    month: String,
+    reason: String,
+    returns: Int,
+    refunded_cents: Int,
+  )
+}
+
+/// Refunded returns grouped by refund month and reason.
+pub fn refunds_by_month(db: Store) -> List(MonthlyRefunds) {
+  db.returns
+  |> dict.values
+  |> list.filter_map(fn(r) {
+    case r.status, r.refunded_at {
+      return_policy.Refunded, Some(refunded_at) ->
+        Ok(#(
+          date.to_iso(date.from_unix_ms(refunded_at)) |> string.slice(0, 7),
+          return_policy.reason_name(r.reason),
+          r,
+        ))
+      _, _ -> Error(Nil)
+    }
+  })
+  |> list.group(fn(row) { #(row.0, row.1) })
+  |> dict.to_list
+  |> list.map(fn(pair) {
+    MonthlyRefunds(
+      month: pair.0.0,
+      reason: pair.0.1,
+      returns: list.length(pair.1),
+      refunded_cents: money.sum(
+        list.map(pair.1, fn(row) { { row.2 }.refund.total_cents }),
+      ),
+    )
+  })
+  |> list.sort(fn(a, b) {
+    case string.compare(a.month, b.month) {
+      ordering.Eq -> string.compare(a.reason, b.reason)
+      other -> other
+    }
+  })
+}
