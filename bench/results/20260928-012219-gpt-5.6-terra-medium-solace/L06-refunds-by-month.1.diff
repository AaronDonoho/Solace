+
+pub fn refunds_by_month_test() {
+  let #(db, march_order, _) =
+    support.delivered(seed.demo_store(), seed.ada, [#("MUG-BLUE", 1)], 3)
+  let march_clock = support.on_day(5)
+  let assert Ok(#(db, march_return)) =
+    returns.request(
+      db,
+      march_clock,
+      march_order.id,
+      [Item("MUG-BLUE", 1)],
+      NoLongerNeeded,
+    )
+  let assert Ok(#(db, _)) = returns.approve(db, march_clock, march_return.id)
+  let assert Ok(#(db, _)) = returns.receive(db, march_clock, march_return.id)
+  let assert Ok(#(db, _)) =
+    returns.refund(db, march_clock, payments.fake_gateway(), march_return.id)
+
+  let #(db, april_order, _) =
+    support.delivered(db, seed.ada, [#("TEE-M-BLK", 1)], 3)
+  let april_clock = support.on_day(32)
+  let assert Ok(#(db, april_return)) =
+    returns.request(
+      db,
+      april_clock,
+      april_order.id,
+      [Item("TEE-M-BLK", 1)],
+      NoLongerNeeded,
+    )
+  let assert Ok(#(db, _)) = returns.approve(db, april_clock, april_return.id)
+  let assert Ok(#(db, _)) = returns.receive(db, april_clock, april_return.id)
+  let assert Ok(#(db, _)) =
+    returns.refund(db, april_clock, payments.fake_gateway(), april_return.id)
+
+  let #(db, damaged_order, _) =
+    support.delivered(db, seed.ada, [#("MUG-BLUE", 1)], 3)
+  let assert Ok(#(db, damaged_return)) =
+    returns.request(
+      db,
+      april_clock,
+      damaged_order.id,
+      [Item("MUG-BLUE", 1)],
+      return_policy.Damaged,
+    )
+  let assert Ok(#(db, _)) = returns.approve(db, april_clock, damaged_return.id)
+  let assert Ok(#(db, _)) = returns.receive(db, april_clock, damaged_return.id)
+  let assert Ok(#(db, _)) =
+    returns.refund(db, april_clock, payments.fake_gateway(), damaged_return.id)
+
+  assert reporting.refunds_by_month(db)
+    == [
+      reporting.MonthlyRefunds("2026-03", "no longer needed", 1, 2080),
+      reporting.MonthlyRefunds("2026-04", "damaged", 1, 2080),
+      reporting.MonthlyRefunds("2026-04", "no longer needed", 1, 2496),
+    ]
+}
