+
+pub fn preview_coupon_test() {
+  let #(db, _) = api.handle(seed.demo_store(), env(), CreateOrder(seed.ada))
+  let #(db, _) = api.handle(db, env(), AddItem(100, "MUG-BLUE", 2))
+
+  let #(previewed_db, preview) =
+    api.handle(db, env(), PreviewCoupon(100, "TENOFF", Standard))
+  assert preview.status == 200
+  assert preview.body
+    == "{\"subtotal_cents\":2800,\"discount_cents\":1000,\"shipping_cents\":600,\"tax_cents\":96,\"total_cents\":2496}"
+
+  assert { api.handle(previewed_db, env(), GetOrder(100)).1 }.body
+    == "{\"id\":100,\"customer_id\":1,\"status\":\"draft\",\"coupon\":null,\"lines\":[{\"sku\":\"MUG-BLUE\",\"quantity\":2,\"unit_price_cents\":1400}]}"
+
+  assert api.handle(db, env(), PreviewCoupon(100, "SPRING", Standard)).1
+    == api.handle(db, env(), ApplyCoupon(100, "SPRING")).1
+}
