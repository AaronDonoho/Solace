 pub fn consolidates_split_reservations_test() {
diff --git a/test/pilot/tax_shipping_test.gleam b/test/pilot/tax_shipping_test.gleam
index fd9bee7..eb33a34 100644
--- a/test/pilot/tax_shipping_test.gleam
+++ b/test/pilot/tax_shipping_test.gleam
@@ -46,4 +46,19 @@ pub fn estimate_delivery_test() {
   // Shipped Monday 2026-03-02, national standard: 4 business days
   let q = shipping.quote(Standard, "NJ", Domestic("NY"), 850, 0)
   assert shipping.estimate_delivery(Date(2026, 3, 2), q) == Date(2026, 3, 6)
+  // The same 4 business days shipped on a Thursday run over the weekend:
+  // Fri 6, Mon 9, Tue 10, Wed 11.
+  assert shipping.estimate_delivery(Date(2026, 3, 5), q) == Date(2026, 3, 11)
+  // Local standard: 2 business days, Friday to Tuesday.
+  let local = shipping.quote(Standard, "NJ", Domestic("NJ"), 850, 0)
+  assert shipping.estimate_delivery(Date(2026, 3, 6), local)
+    == Date(2026, 3, 10)
+  // Express national: 2 business days from Thursday = Monday.
+  let express = shipping.quote(Express, "NJ", Domestic("NY"), 850, 0)
+  assert shipping.estimate_delivery(Date(2026, 3, 5), express)
+    == Date(2026, 3, 9)
+  // Overseas standard: 10 business days from Thursday = the Thursday after.
+  let overseas = shipping.quote(Standard, "NJ", International("DE"), 850, 0)
+  assert shipping.estimate_delivery(Date(2026, 3, 5), overseas)
+    == Date(2026, 3, 19)
 }
