@@ -102,3 +102,20 @@ pub fn must_receive_before_refund_test() {
     returns.refund(db, c, gateway(), r.id)
   assert inventory.available(db.stock, "WH-EAST", "MUG-BLUE") == 29
 }
+
+pub fn partial_return_keeps_shipping_test() {
+  // Two T-shirts and a mug; the customer returns both T-shirts, keeps the mug.
+  let #(db, o, _) =
+    support.delivered(
+      seed.demo_store(),
+      seed.ada,
+      [#("TEE-M-BLK", 2), #("MUG-BLUE", 1)],
+      3,
+    )
+  let c = support.on_day(5)
+  let assert Ok(#(_, r)) =
+    returns.request(db, c, o.id, [Item("TEE-M-BLK", 2)], NoLongerNeeded)
+  assert r.refund.shipping_cents == 0
+  // 2 x 1800 goods, no discount, 224 tax apportioned over 3600/5000 = 161.
+  assert r.refund.total_cents == 3761
+}
