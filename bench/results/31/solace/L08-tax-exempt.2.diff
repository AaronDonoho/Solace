+          Error(_) -> False
+        }
+      })
+      |> list.length
     RegionTax(
       region: pair.0,
       orders: list.length(pair.1),
       tax_cents: money.sum(list.map(pair.1, fn(s) { { s.1 }.tax_cents })),
