diff --git a/test/pilot/checkout_test.gleam b/test/pilot/checkout_test.gleam
index a9a0fa4..1245aac 100644
--- a/test/pilot/checkout_test.gleam
+++ b/test/pilot/checkout_test.gleam
@@ -174,3 +174,20 @@ pub fn origin_warehouse_test() {
   assert checkout.origin_warehouse([], customer.Domestic("CA"))
     == Error(checkout.NoWarehouse)
 }
+
+pub fn tax_exempt_quote_test() {
+  let #(db, o) =
+    support.draft(seed.demo_store(), seed.ada, [
+      #("TEE-M-BLK", 2),
+      #("MUG-BLUE", 1),
+    ])
+  let assert Ok(paying) = checkout.quote(db, o.id, Standard)
+  assert paying.tax_cents == 224
+  let assert Ok(ada) = store.get_customer(db, seed.ada)
+  let exempt_db =
+    store.put_customer(db, customer.Customer(..ada, tax_exempt: True))
+  let assert Ok(exempt) = checkout.quote(exempt_db, o.id, Standard)
+  assert exempt.tax_cents == 0
+  assert exempt.shipping_cents == paying.shipping_cents
+  assert exempt.total_cents == 5600
+}
