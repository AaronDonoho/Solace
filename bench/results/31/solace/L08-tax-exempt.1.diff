@@ -174,3 +174,18 @@ pub fn origin_warehouse_test() {
   assert checkout.origin_warehouse([], customer.Domestic("CA"))
     == Error(checkout.NoWarehouse)
 }
+
+pub fn pay_tax_exempt_test() {
+  let db = support.exempt(seed.demo_store(), seed.ada)
+  let #(db, o) =
+    support.draft(db, seed.ada, [#("TEE-M-BLK", 2), #("MUG-BLUE", 1)])
+  let c = support.on_day(0)
+  let assert Ok(#(db, _)) = checkout.submit(db, c, o.id)
+  let assert Ok(#(db, o)) =
+    checkout.pay(db, c, payments.fake_gateway(), o.id, "tok_ok", Standard)
+  let assert Ok(quote) = store.get_quote(db, o.id)
+  assert quote.tax_cents == 0
+  assert quote.total_cents == 5600
+  let assert Ok(p) = store.payment_for_order(db, o.id)
+  assert p.amount_cents == 5600
+}
