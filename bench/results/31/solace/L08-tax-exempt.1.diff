+/// A copy of `db` with the customer marked tax-exempt.
+pub fn exempt(db: Store, customer_id: Int) -> Store {
+  let assert Ok(c) = store.get_customer(db, customer_id)
+  store.put_customer(db, customer.Customer(..c, tax_exempt: True))
+}
