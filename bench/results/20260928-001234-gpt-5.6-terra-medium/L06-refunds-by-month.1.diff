+pub fn refunds_by_month_test() {
+  let #(db, o, _) =
+    support.delivered(
+      seed.demo_store(),
+      seed.ada,
+      [#("TEE-M-BLK", 2), #("MUG-BLUE", 1)],
+      3,
+    )
+  let march = support.on_day(5)
+  let april = support.on_day(31)
+  let assert Ok(#(db, damaged)) =
+    returns.request(db, march, o.id, [Item("MUG-BLUE", 1)], Damaged)
+  let assert Ok(#(db, damaged_tee)) =
+    returns.request(db, march, o.id, [Item("TEE-M-BLK", 1)], Damaged)
+  let assert Ok(#(db, unwanted_april)) =
+    returns.request(db, march, o.id, [Item("TEE-M-BLK", 1)], NoLongerNeeded)
+  let assert Ok(#(db, _)) = returns.approve(db, march, damaged.id)
+  let assert Ok(#(db, _)) = returns.receive(db, march, damaged.id)
+  let assert Ok(#(db, damaged)) =
+    returns.refund(db, march, payments.fake_gateway(), damaged.id)
+  let assert Ok(#(db, _)) = returns.approve(db, march, damaged_tee.id)
+  let assert Ok(#(db, _)) = returns.receive(db, march, damaged_tee.id)
+  let assert Ok(#(db, damaged_tee)) =
+    returns.refund(db, march, payments.fake_gateway(), damaged_tee.id)
+  let assert Ok(#(db, _)) = returns.approve(db, april, unwanted_april.id)
+  let assert Ok(#(db, _)) = returns.receive(db, april, unwanted_april.id)
+  let assert Ok(#(db, unwanted_april)) =
+    returns.refund(db, april, payments.fake_gateway(), unwanted_april.id)
+  assert reporting.refunds_by_month(db)
+    == [
+      MonthlyRefunds(
+        "2026-03",
+        "damaged",
+        2,
+        damaged.refund.total_cents + damaged_tee.refund.total_cents,
+      ),
+      MonthlyRefunds(
+        "2026-04",
+        "no longer needed",
+        1,
+        unwanted_april.refund.total_cents,
+      ),
+    ]
+}
