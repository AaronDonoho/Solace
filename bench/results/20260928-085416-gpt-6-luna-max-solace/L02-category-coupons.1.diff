+
+fn category_spend(
+  lines: List(Line),
+  categories: Dict(String, catalog.Category),
+  category: catalog.Category,
+) -> #(Bool, Int) {
+  list.fold(lines, #(False, 0), fn(total, line) {
+    case dict.get(categories, line.sku) {
+      Ok(line_category) if line_category == category -> #(
+        True,
+        total.1 + line.quantity * line.unit_price_cents,
+      )
+      _ -> total
+    }
+  })
+}
+
+/// The amount a coupon takes off the applicable order value.
+pub fn discount_with_categories(
+  coupon: Coupon,
+  lines: List(Line),
+  categories: Dict(String, catalog.Category),
+  base_cents: Int,
+) -> Int {
+  let category_base = case coupon.category {
+    Some(category) -> category_spend(lines, categories, category).1
+    None -> base_cents
+  }
+  let amount = case coupon.kind {
+    PercentOff(percent) -> money.percent(category_base, percent)
+    FixedOff(cents) -> int.clamp(cents, 0, category_base)
+    FreeShipping -> 0
+    BuyXGetY(sku:, buy:, get:) ->
+      case list.find(lines, fn(l) { l.sku == sku }) {
+        Ok(line) -> {
+          let matches_category = case coupon.category {
+            Some(category) ->
+              case dict.get(categories, line.sku) {
+                Ok(line_category) -> line_category == category
+                Error(_) -> False
+              }
+            None -> True
+          }
+          case matches_category {
+            True -> line.quantity / { buy + get } * get * line.unit_price_cents
+            False -> 0
+          }
+        }
+        Error(_) -> 0
+      }
+  }
+  int.clamp(amount, 0, base_cents)
+}
