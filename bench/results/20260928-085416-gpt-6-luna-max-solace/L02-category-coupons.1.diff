diff --git a/test/pilot/checkout_test.gleam b/test/pilot/checkout_test.gleam
index a9a0fa4..0be48ff 100644
--- a/test/pilot/checkout_test.gleam
+++ b/test/pilot/checkout_test.gleam
@@ -174,3 +174,45 @@ pub fn origin_warehouse_test() {
   assert checkout.origin_warehouse([], customer.Domestic("CA"))
     == Error(checkout.NoWarehouse)
 }
+
+pub fn category_coupon_checkout_test() {
+  let category_coupon =
+    promotions.Coupon(
+      code: "BOOKS20",
+      kind: promotions.PercentOff(20),
+      category: Some(catalog.Books),
+      min_spend_cents: 2000,
+      expires_at: None,
+      max_uses_per_customer: None,
+      stacks_with_loyalty: True,
+      active: True,
+    )
+  let db = store.put_coupon(seed.demo_store(), category_coupon)
+  let #(db, small_books) =
+    support.draft(db, seed.ada, [#("BOOK-NOVEL", 1), #("TEE-M-BLK", 1)])
+  assert checkout.apply_coupon(db, support.on_day(0), small_books.id, "BOOKS20")
+    == Error(
+      checkout.CouponRejected(promotions.BelowMinimumSpend("BOOKS20", 2000)),
+    )
+
+  let #(db, books_order) =
+    support.draft(db, seed.ada, [#("BOOK-NOVEL", 2), #("TEE-M-BLK", 1)])
+  let assert Ok(#(db, books_order)) =
+    checkout.apply_coupon(db, support.on_day(0), books_order.id, "BOOKS20")
+  let assert Ok(q) = checkout.quote(db, books_order.id, Standard)
+  assert q.coupon_discount_cents == 480
+
+  let #(db, apparel_order) = support.draft(db, seed.grace, [#("TEE-M-BLK", 1)])
+  assert checkout.apply_coupon(
+      db,
+      support.on_day(0),
+      apparel_order.id,
+      "BOOKS20",
+    )
+    == Error(
+      checkout.CouponRejected(promotions.NotApplicable(
+        "BOOKS20",
+        "requires items in Books",
+      )),
+    )
+}
