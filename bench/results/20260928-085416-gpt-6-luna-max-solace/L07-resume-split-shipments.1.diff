+pub fn split_shipments_ship_and_deliver_incrementally_test() {
+  let #(db, o) =
+    support.paid(seed.demo_store(), seed.ada, [#("HOOD-M-GRY", 10)])
+  let assert Ok(#(db, [east, west])) =
+    fulfillment.start_picking(db, support.on_day(1), o.id, Standard)
+  let assert Ok(#(db, east)) = fulfillment.pack(db, support.on_day(1), east.id)
+  let assert Ok(#(db, west)) = fulfillment.pack(db, support.on_day(1), west.id)
+
+  let assert Ok(#(db, east)) =
+    fulfillment.ship(db, support.on_day(1), payments.fake_gateway(), east.id)
+  let assert Ok(p) = store.payment_for_order(db, o.id)
+  assert p.status == payments.Captured
+  let assert Ok(current_order) = store.get_order(db, o.id)
+  assert current_order.status == order.Picking
+  assert store.allocations_for(db, o.id)
+    == [Allocation("WH-WEST", "HOOD-M-GRY", 2)]
+  assert dict.get(db.stock.on_hand, #("WH-EAST", "HOOD-M-GRY")) == Ok(0)
+
+  let assert Ok(#(db, west)) =
+    fulfillment.ship(db, support.on_day(1), payments.fake_gateway(), west.id)
+  let assert Ok(current_order) = store.get_order(db, o.id)
+  assert current_order.status == order.Shipped
+  assert store.allocations_for(db, o.id) == []
+  assert dict.get(db.stock.on_hand, #("WH-WEST", "HOOD-M-GRY")) == Ok(3)
+
+  let assert Ok(#(db, _)) = fulfillment.deliver(db, support.on_day(3), east.id)
+  let assert Ok(current_order) = store.get_order(db, o.id)
+  assert current_order.status == order.Shipped
+  assert list.filter(store.sent_messages(db), fn(m) {
+      m.kind == notifications.OrderDelivered
+    })
+    == []
+
+  let assert Ok(#(db, _)) = fulfillment.deliver(db, support.on_day(4), west.id)
+  let assert Ok(current_order) = store.get_order(db, o.id)
+  assert current_order.status == order.Delivered
+  assert list.filter(store.sent_messages(db), fn(m) {
+      m.kind == notifications.OrderDelivered
+    })
+    |> list.length
+    == 1
+}
