+# Solace project settings. Human-owned; agents may read this file.
+# File writes are limited to this many bytes.
+resource_limit = 262144
+# Classification only: unlisted files are also readable and writable.
+resources = []
+ignore = []
+
+[validators]
+# Optional checks, for example:
+# "docs/**/*.json" = ["python3", "-m", "json.tool", "{file}"]
