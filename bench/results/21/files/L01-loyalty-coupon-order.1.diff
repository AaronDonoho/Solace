+pub fn gold_fixed_coupon_quote_test() {
+  // Grace (Gold), one Desk Lamp and TENOFF, standard shipping: the 5% tier
+  // discount comes off the full price before the coupon, so 7400 - 370 - 1000
+  // = 6030 goods, plus 600 shipping and 437 CA tax.
+  let #(db, o) = support.draft(seed.demo_store(), seed.grace, [#("LAMP-OAK", 1)])
+  let c = support.on_day(0)
+  let assert Ok(#(db, o)) = checkout.apply_coupon(db, c, o.id, "TENOFF")
+  assert o.coupon_code == Some("TENOFF")
+  let assert Ok(q) = checkout.quote(db, o.id, Standard)
+  assert q.loyalty_discount_cents == 370
+  assert q.coupon_discount_cents == 1000
+  assert q.shipping_cents == 600
+  assert q.tax_cents == 437
+  assert q.total_cents == 7067
+}
