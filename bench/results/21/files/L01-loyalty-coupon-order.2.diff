+pub fn fixed_coupon_after_loyalty_test() {
+  // Gold 5% comes off the full subtotal, then the fixed coupon takes its
+  // face value from what is left: 7400 - 370 - 1000 = 6030.
+  let q =
+    pricing.quote(
+      [Line("L", 1, 7400)],
+      Gold,
+      Some(coupon(FixedOff(1000), True)),
+      ship(600),
+      Domestic("CA"),
+    )
+  assert q.loyalty_discount_cents == 370
+  assert q.coupon_discount_cents == 1000
+  assert pricing.goods_cents(q) == 6030
+  assert q.tax_cents == 437
+  assert q.total_cents == 7067
+}
+
+pub fn fixed_coupon_clamps_to_remaining_test() {
+  // The coupon cannot take more than the order is worth after loyalty:
+  // 1000 - 50 = 950, so the coupon is clamped to 950.
+  let q =
+    pricing.quote(
+      [Line("A", 1, 1000)],
+      Gold,
+      Some(coupon(FixedOff(1000), True)),
+      ship(0),
+      Domestic("OR"),
+    )
+  assert q.loyalty_discount_cents == 50
+  assert q.coupon_discount_cents == 950
+  assert q.total_cents == 0
+}
+
+pub fn volume_after_loyalty_and_coupon_test() {
+  // 20 units: 2000 - 100 loyalty - 500 coupon = 1400, then 5% volume = 70.
+  let q =
+    pricing.quote(
+      [Line("A", 20, 100)],
+      Gold,
+      Some(coupon(FixedOff(500), True)),
+      ship(0),
+      Domestic("OR"),
+    )
+  assert q.loyalty_discount_cents == 100
+  assert q.volume_discount_cents == 70
+  assert q.total_cents == 1330
+}
