diff --git a/test/pilot/checkout_test.gleam b/test/pilot/checkout_test.gleam
index a9a0fa4..d78bf40 100644
--- a/test/pilot/checkout_test.gleam
+++ b/test/pilot/checkout_test.gleam
@@ -9,6 +9,7 @@ import pilot/inventory
 import pilot/notifications
 import pilot/order.{Line}
 import pilot/payments
+import pilot/pricing
 import pilot/promotions
 import pilot/seed
 import pilot/shipping.{Standard}
@@ -174,3 +175,17 @@ pub fn origin_warehouse_test() {
   assert checkout.origin_warehouse([], customer.Domestic("CA"))
     == Error(checkout.NoWarehouse)
 }
+
+pub fn gold_fixed_coupon_quote_test() {
+  // Grace (Gold) buys one Desk Lamp with TENOFF and standard shipping.
+  let #(db, o) =
+    support.draft(seed.demo_store(), seed.grace, [#("LAMP-OAK", 1)])
+  let c = support.on_day(0)
+  let assert Ok(#(db, _)) = checkout.apply_coupon(db, c, o.id, "TENOFF")
+  let assert Ok(q) = checkout.quote(db, o.id, Standard)
+  assert q.subtotal_cents == 7400
+  assert q.loyalty_discount_cents == 370
+  assert q.coupon_discount_cents == 1000
+  assert pricing.goods_cents(q) == 6030
+  assert q.total_cents == 7067
+}
diff --git a/test/pilot/pricing_test.gleam b/test/pilot/pricing_test.gleam
index 66182f0..006546d 100644
--- a/test/pilot/pricing_test.gleam
+++ b/test/pilot/pricing_test.gleam
@@ -2,7 +2,7 @@ import gleam/option.{None, Some}
 import pilot/customer.{Domestic, Gold, Standard}
 import pilot/order.{Line}
 import pilot/pricing
-import pilot/promotions.{Coupon, FreeShipping, PercentOff}
+import pilot/promotions.{Coupon, FixedOff, FreeShipping, PercentOff}
 import pilot/shipping
 
 fn ship(cost) {
@@ -77,3 +77,37 @@ pub fn free_shipping_coupon_test() {
   assert q.shipping_cents == 0
   assert q.tax_cents == 40
 }
+
+pub fn fixed_coupon_after_loyalty_test() {
+  // The ticket: Gold 5% comes off the full price first, then the $10 coupon
+  // off what is left: 7400 - 370 = 7030, - 1000 = 6030.
+  let q =
+    pricing.quote(
+      [Line("L", 1, 7400)],
+      Gold,
+      Some(coupon(FixedOff(1000), True)),
+      ship(600),
+      Domestic("CA"),
+    )
+  assert q.loyalty_discount_cents == 370
+  assert q.coupon_discount_cents == 1000
+  assert pricing.goods_cents(q) == 6030
+  assert q.total_cents == 6030 + 600 + 437
+}
+
+pub fn fixed_coupon_clamped_after_loyalty_test() {
+  // A fixed coupon never exceeds what is left for it to discount:
+  // 1000 - 50 loyalty leaves 950.
+  let q =
+    pricing.quote(
+      [Line("L", 1, 1000)],
+      Gold,
+      Some(coupon(FixedOff(1000), True)),
+      ship(0),
+      Domestic("OR"),
+    )
+  assert q.loyalty_discount_cents == 50
+  assert q.coupon_discount_cents == 950
+  assert pricing.goods_cents(q) == 0
+  assert q.total_cents == 0
+}
