+pub fn category_coupon_test() {
+  let db =
+    seed.demo_store()
+    |> store.put_coupon(promotions.Coupon(
+      "BOOK20",
+      promotions.PercentOff(20),
+      2000,
+      None,
+      None,
+      True,
+      True,
+      Some(catalog.Books),
+    ))
+  // The order subtotal is $60, but only the $24 in books is discounted.
+  let #(db, o) =
+    support.draft(db, seed.ada, [#("BOOK-NOVEL", 2), #("TEE-M-BLK", 1)])
+  let c = support.on_day(0)
+  let assert Ok(#(db, _)) = checkout.apply_coupon(db, c, o.id, "BOOK20")
+  let assert Ok(q) = checkout.quote(db, o.id, Standard)
+  assert q.coupon_discount_cents == 480
+
+  let db =
+    db
+    |> store.put_coupon(promotions.Coupon(
+      "BOOK50",
+      promotions.FixedOff(5000),
+      0,
+      None,
+      None,
+      True,
+      True,
+      Some(catalog.Books),
+    ))
+  let assert Ok(#(db, _)) = checkout.apply_coupon(db, c, o.id, "BOOK50")
+  let assert Ok(q) = checkout.quote(db, o.id, Standard)
+  assert q.coupon_discount_cents == 2400
+
+  let db =
+    db
+    |> store.put_coupon(promotions.Coupon(
+      "BOOKMIN",
+      promotions.PercentOff(10),
+      3000,
+      None,
+      None,
+      True,
+      True,
+      Some(catalog.Books),
+    ))
+  let #(db, below_minimum) =
+    support.draft(db, seed.ada, [#("BOOK-NOVEL", 2), #("TEE-M-BLK", 1)])
+  assert checkout.apply_coupon(db, c, below_minimum.id, "BOOKMIN")
+    == Error(CouponRejected(promotions.BelowMinimumSpend("BOOKMIN", 3000)))
+
+  let #(db, apparel_order) = support.draft(db, seed.ada, [#("TEE-M-BLK", 1)])
+  let assert Error(CouponRejected(promotions.NotApplicable("BOOK20", _))) =
+    checkout.apply_coupon(db, c, apparel_order.id, "BOOK20")
+}
