       }
-    _ -> Ok(coupon)
+  }
+}
+
+fn applicable_subtotal(coupon: Coupon, context: CouponContext) -> Int {
+  case coupon.category, context.category_subtotal_cents {
+    Some(_), Some(subtotal) -> subtotal
+    Some(_), None -> 0
+    None, _ -> context.subtotal_cents
+  }
+}
+
+fn category_is_absent(coupon: Coupon, context: CouponContext) -> Bool {
+  case coupon.category, context.category_subtotal_cents {
+    Some(_), Some(subtotal) -> subtotal == 0
+    Some(_), None -> True
+    None, _ -> False
   }
 }
 
