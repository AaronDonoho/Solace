+fn payment_failed(
+  db: Store,
+  now: Int,
+  order_id: Int,
+  attempts: Int,
+  error: CheckoutError,
+) -> #(Store, Result(Order, CheckoutError)) {
+  case store.get_order(db, order_id) {
+    Error(Nil) -> #(db, Error(error))
+    Ok(existing) ->
+      case store.get_customer(db, existing.customer_id) {
+        Error(Nil) -> #(db, Error(error))
+        Ok(customer) -> {
+          let updated =
+            db
+            |> store.send(notifications.payment_failed(
+              customer,
+              order_id,
+              attempts,
+              now,
+            ))
+            |> store.record(
+              now,
+              actor,
+              "payment failed",
+              audit.order_subject(order_id),
+              "",
+            )
+          #(updated, Error(error))
+        }
+      }
+  }
+}
