+pub fn refunds_by_month_test() {
+  let #(db, first_order, _) =
+    support.delivered(seed.demo_store(), seed.ada, [#("MUG-BLUE", 1)], 3)
+  let #(db, second_order, _) =
+    support.delivered(db, seed.barbara, [#("TEE-M-BLK", 1)], 3)
+  let requested = support.on_day(5)
+  let assert Ok(#(db, first)) =
+    returns.request(
+      db,
+      requested,
+      first_order.id,
+      [Item("MUG-BLUE", 1)],
+      Damaged,
+    )
+  let assert Ok(#(db, _)) = returns.approve(db, requested, first.id)
+  let assert Ok(#(db, _)) = returns.receive(db, requested, first.id)
+  let assert Ok(#(db, _)) =
+    returns.refund(db, requested, payments.fake_gateway(), first.id)
+  let assert Ok(#(db, second)) =
+    returns.request(
+      db,
+      requested,
+      second_order.id,
+      [Item("TEE-M-BLK", 1)],
+      NoLongerNeeded,
+    )
+  let assert Ok(#(db, _)) = returns.approve(db, requested, second.id)
+  let assert Ok(#(db, _)) = returns.receive(db, requested, second.id)
+  let assert Ok(#(db, _)) =
+    returns.refund(db, support.on_day(35), payments.fake_gateway(), second.id)
+
+  assert reporting.refunds_by_month(db)
+    == [
+      MonthlyRefunds("2026-03", "damaged", 1, 2080),
+      MonthlyRefunds("2026-04", "no longer needed", 1, 2400),
+    ]
+}
