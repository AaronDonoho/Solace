+/// Refunded returns grouped by their UTC refund month and reason.
+pub fn refunds_by_month(db: Store) -> List(MonthlyRefunds) {
+  db.returns
+  |> dict.values
+  |> list.filter_map(fn(r) {
+    case r.status, r.refunded_at {
+      return_policy.Refunded, Some(refunded_at) ->
+        Ok(#(refund_month(refunded_at), return_policy.reason_name(r.reason), r))
+      _, _ -> Error(Nil)
+    }
+  })
+  |> list.group(fn(r) { #(r.0, r.1) })
+  |> dict.to_list
+  |> list.map(fn(pair) {
+    MonthlyRefunds(
+      month: pair.0.0,
+      reason: pair.0.1,
+      returns: list.length(pair.1),
+      refunded_cents: money.sum(
+        list.map(pair.1, fn(r) { r.2.refund.total_cents }),
+      ),
+    )
+  })
+  |> list.sort(fn(a, b) {
+    case string.compare(a.month, b.month) {
+      ordering.Eq -> string.compare(a.reason, b.reason)
+      other -> other
+    }
+  })
+}
+
+fn refund_month(refunded_at: Int) -> String {
+  let refunded_on = date.from_unix_ms(refunded_at)
+  string.pad_start(int.to_string(refunded_on.year), 4, "0")
+  <> "-"
+  <> string.pad_start(int.to_string(refunded_on.month), 2, "0")
+}
