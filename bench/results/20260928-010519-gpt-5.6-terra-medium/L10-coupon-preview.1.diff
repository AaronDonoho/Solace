+pub fn preview_coupon_test() {
+  let #(db, _) = api.handle(seed.demo_store(), env(), CreateOrder(seed.ada))
+  let #(db, _) = api.handle(db, env(), AddItem(100, "MUG-BLUE", 2))
+  let #(same_db, preview) =
+    api.handle(db, env(), PreviewCoupon(100, "TENOFF", Standard))
+  assert preview
+    == Response(
+      200,
+      "{\"subtotal_cents\":2800,\"discount_cents\":1000,\"shipping_cents\":600,\"tax_cents\":96,\"total_cents\":2496}",
+    )
+  assert same_db == db
+  let #(_, order) = api.handle(same_db, env(), GetOrder(100))
+  assert string.contains(order.body, "\"coupon\":null")
+  let #(db_with_coupon, _) =
+    api.handle(same_db, env(), ApplyCoupon(100, "TENOFF"))
+  let #(unchanged_db, _) =
+    api.handle(db_with_coupon, env(), PreviewCoupon(100, "SHIPFREE", Standard))
+  assert unchanged_db == db_with_coupon
+  let #(_, order) = api.handle(unchanged_db, env(), GetOrder(100))
+  assert string.contains(order.body, "\"coupon\":\"TENOFF\"")
+  assert { api.handle(db, env(), PreviewCoupon(100, "SPRING", Standard)).1 }.body
+    == { api.handle(db, env(), ApplyCoupon(100, "SPRING")).1 }.body
+}
