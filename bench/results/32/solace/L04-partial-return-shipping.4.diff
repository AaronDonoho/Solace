+
+pub fn partial_return_keeps_shipping_test() {
+  let #(db, o, _) =
+    support.delivered(
+      seed.demo_store(),
+      seed.ada,
+      [#("TEE-M-BLK", 2), #("MUG-BLUE", 1)],
+      3,
+    )
+  let c = support.on_day(5)
+  let assert Ok(#(_, last)) =
+    returns.request(db, c, o.id, [Item("TEE-M-BLK", 2)], NoLongerNeeded)
+  assert last.refund.shipping_cents == 0
+  assert last.refund.total_cents == 3761
+}
