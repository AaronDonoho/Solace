diff --git a/solace.toml b/solace.toml
new file mode 100644
index 0000000..bac0ebb
--- /dev/null
+++ b/solace.toml
@@ -0,0 +1,13 @@
+# Solace project settings. Protected: agents may read this file.
+# Text files up to this many bytes are watched; file writes are limited to it.
+watch_limit = 262144
+# Files Solace doesn't watch or search (agents can still read and write them).
+unwatched = []
+
+[validators]
+# Optional checks, for example:
+# "docs/**/*.json" = ["python3", "-m", "json.tool", "{file}"]
+
+[commands]
+# Optional commands agents may run, for example:
+# app = { run = ["gleam", "run", "--"], args = true }
diff --git a/src/pilot/date.gleam b/src/pilot/date.gleam
index eb788e7..acacd6f 100644
--- a/src/pilot/date.gleam
+++ b/src/pilot/date.gleam
@@ -112,7 +112,10 @@ pub fn add_business_days(date: Date, days: Int) -> Date {
     True -> date
     False -> {
       let next = add_days(date, 1)
-      add_business_days(next, days - 1)
+      case is_weekend(next) {
+        True -> add_business_days(next, days)
+        False -> add_business_days(next, days - 1)
+      }
     }
   }
 }
diff --git a/test/pilot/date_test.gleam b/test/pilot/date_test.gleam
index 7cb0319..2399bb0 100644
--- a/test/pilot/date_test.gleam
+++ b/test/pilot/date_test.gleam
@@ -23,6 +23,10 @@ pub fn business_days_test() {
   // Monday + 3 business days = Thursday
   assert date.add_business_days(Date(2026, 3, 2), 3) == Date(2026, 3, 5)
   assert date.add_business_days(Date(2026, 3, 2), 0) == Date(2026, 3, 2)
+  // Thursday + 4 business days skips the weekend = Wednesday
+  assert date.add_business_days(Date(2026, 3, 5), 4) == Date(2026, 3, 11)
+  // Starting on a weekend counts from the following Monday
+  assert date.add_business_days(Date(2026, 3, 7), 1) == Date(2026, 3, 9)
 }
 
 pub fn days_between_and_iso_test() {
diff --git a/test/pilot/tax_shipping_test.gleam b/test/pilot/tax_shipping_test.gleam
index fd9bee7..cade337 100644
--- a/test/pilot/tax_shipping_test.gleam
+++ b/test/pilot/tax_shipping_test.gleam
@@ -46,4 +46,7 @@ pub fn estimate_delivery_test() {
   // Shipped Monday 2026-03-02, national standard: 4 business days
   let q = shipping.quote(Standard, "NJ", Domestic("NY"), 850, 0)
   assert shipping.estimate_delivery(Date(2026, 3, 2), q) == Date(2026, 3, 6)
+  // Shipped Thursday 2026-03-05, national standard: 4 business days
+  // skipping the weekend = Wednesday 2026-03-11
+  assert shipping.estimate_delivery(Date(2026, 3, 5), q) == Date(2026, 3, 11)
 }
