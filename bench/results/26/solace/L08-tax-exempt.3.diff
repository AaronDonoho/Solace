diff --git a/test/pilot/checkout_test.gleam b/test/pilot/checkout_test.gleam
index a9a0fa4..a1fa8c0 100644
--- a/test/pilot/checkout_test.gleam
+++ b/test/pilot/checkout_test.gleam
@@ -174,3 +174,30 @@ pub fn origin_warehouse_test() {
   assert checkout.origin_warehouse([], customer.Domestic("CA"))
     == Error(checkout.NoWarehouse)
 }
+
+pub fn quote_skips_tax_for_exempt_customer_test() {
+  let school =
+    customer.Customer(
+      id: 5,
+      name: "Riverside School",
+      email: "office@riverside.example",
+      shipping_address: customer.Address(
+        "12 School Rd",
+        "Albany",
+        "12207",
+        customer.Domestic("NY"),
+      ),
+      lifetime_spend_cents: 0,
+      created_at: seed.epoch,
+      tax_exempt: True,
+    )
+  let db = store.put_customer(seed.demo_store(), school)
+  let #(db, o) = support.draft(db, school.id, [#("MUG-BLUE", 1)])
+  let assert Ok(q) = checkout.quote(db, o.id, Standard)
+  assert q.tax_cents == 0
+  assert q.total_cents == 2000
+  let #(db, o) = support.draft(db, seed.ada, [#("MUG-BLUE", 1)])
+  let assert Ok(q) = checkout.quote(db, o.id, Standard)
+  assert q.tax_cents == 80
+  assert q.total_cents == 2080
+}
