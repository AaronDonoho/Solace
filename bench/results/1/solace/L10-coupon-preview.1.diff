--- a/test/pilot/api_test.gleam
+++ b/test/pilot/api_test.gleam
@@ -7,6 +7,7 @@ import pilot/date.{Date}
 import pilot/payments
 import pilot/seed
 import pilot/shipping.{Standard}
+import pilot/store
 import support
 
 fn env() {
@@ -63,3 +64,30 @@ pub fn parsing_test() {
   assert api.parse_date("2026-13-02") == Error(Nil)
   assert api.parse_reason(" Damaged ") == api.parse_reason("damaged")
 }
+
+pub fn preview_coupon_test() {
+  let #(db, draft) =
+    support.draft(seed.demo_store(), seed.ada, [#("TEE-M-BLK", 1)])
+  let test_env = env()
+  let #(db, _) = api.handle(db, test_env, ApplyCoupon(draft.id, "TENOFF"))
+  let assert Ok(original_order) = store.get_order(db, draft.id)
+
+  let #(preview_db, preview) =
+    api.handle(db, test_env, api.PreviewCoupon(draft.id, "WELCOME15", Standard))
+  assert preview.status == 200
+  assert preview_db == db
+  assert store.get_order(preview_db, draft.id) == Ok(original_order)
+
+  let #(applied_db, _) =
+    api.handle(db, test_env, ApplyCoupon(draft.id, "WELCOME15"))
+  let #(_, expected_quote) =
+    api.handle(applied_db, test_env, GetQuote(draft.id, Standard))
+  assert preview.body == expected_quote.body
+
+  let #(_, apply_error) =
+    api.handle(db, test_env, ApplyCoupon(draft.id, "SPRING"))
+  let #(error_db, preview_error) =
+    api.handle(db, test_env, api.PreviewCoupon(draft.id, "SPRING", Standard))
+  assert error_db == db
+  assert preview_error == apply_error
+}
