 import gleam/dict.{type Dict}
 import gleam/int
 import gleam/list
-import gleam/option.{Some}
+import gleam/option.{None, Some}
 import gleam/order as ordering
 import gleam/result
 import gleam/string
@@ -203,3 +203,55 @@ pub fn sales_summary(db: Store, from: Date, to: Date) -> String {
   <> money.format(sum(fn(d) { d.net_cents }))
   <> "\n"
 }
+
+pub type MonthlyRefunds {
+  MonthlyRefunds(
+    month: String,
+    reason: String,
+    returns: Int,
+    refunded_cents: Int,
+  )
+}
+
+/// Refunded returns grouped by refund month and reason.
+pub fn refunds_by_month(db: Store) -> List(MonthlyRefunds) {
+  db.returns
+  |> dict.values
+  |> list.filter_map(fn(r) {
+    case r.status {
+      return_policy.Refunded ->
+        case r.refunded_at {
+          Some(at) -> {
+            let refunded_on = date.from_unix_ms(at)
+            let month =
+              string.pad_start(int.to_string(refunded_on.year), 4, "0")
+              <> "-"
+              <> string.pad_start(int.to_string(refunded_on.month), 2, "0")
+            Ok(#(
+              #(month, return_policy.reason_name(r.reason)),
+              r.refund.total_cents,
+            ))
+          }
+          None -> Error(Nil)
+        }
+      _ -> Error(Nil)
+    }
+  })
+  |> list.group(fn(row) { row.0 })
+  |> dict.to_list
+  |> list.map(fn(group) {
+    let #(month, reason) = group.0
+    MonthlyRefunds(
+      month:,
+      reason:,
+      returns: list.length(group.1),
+      refunded_cents: money.sum(list.map(group.1, fn(row) { row.1 })),
+    )
+  })
+  |> list.sort(fn(a, b) {
+    case string.compare(a.month, b.month) {
+      ordering.Eq -> string.compare(a.reason, b.reason)
+      other -> other
+    }
+  })
+}
