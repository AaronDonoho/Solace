+pub fn preview_coupon_test() {
+  let db = seed.demo_store()
+  let #(db, _) = api.handle(db, env(), CreateOrder(seed.ada))
+  let #(db, _) = api.handle(db, env(), AddItem(100, "MUG-BLUE", 2))
+  let #(db, _) = api.handle(db, env(), ApplyCoupon(100, "SHIPFREE"))
+
+  let assert Ok(order_before) = store.get_order(db, 100)
+  let #(preview_db, preview) =
+    api.handle(db, env(), PreviewCoupon(100, "TENOFF", Standard))
+  let #(applied_db, applied) = api.handle(db, env(), ApplyCoupon(100, "TENOFF"))
+  let #(_, applied_quote) =
+    api.handle(applied_db, env(), GetQuote(100, Standard))
+
+  assert preview.status == 200
+  assert preview.body == applied_quote.body
+  assert preview_db == db
+  assert store.get_order(preview_db, 100) == Ok(order_before)
+  assert applied.status == 200
+}
+
+pub fn preview_coupon_error_test() {
+  let db = seed.demo_store()
+  let #(db, _) = api.handle(db, env(), CreateOrder(seed.ada))
+  let #(db, _) = api.handle(db, env(), AddItem(100, "MUG-BLUE", 1))
+
+  let #(preview_db, preview) =
+    api.handle(db, env(), PreviewCoupon(100, "SPRING", Standard))
+  let #(_, applied) = api.handle(db, env(), ApplyCoupon(100, "SPRING"))
+
+  assert preview == applied
+  assert preview_db == db
+}
