diff --git a/src/pilot/return_policy.gleam b/src/pilot/return_policy.gleam
index cd15ae9..d9ffc44 100644
--- a/src/pilot/return_policy.gleam
+++ b/src/pilot/return_policy.gleam
@@ -144,13 +144,19 @@ pub fn completes_order(
   items: List(Item),
   already_returned: Dict(String, Int),
 ) -> Bool {
-  list.all(items, fn(item) {
-    let before = dict.get(already_returned, item.sku) |> result.unwrap(0)
-    let bought = case order.find_line(order, item.sku) {
-      Ok(line) -> line.quantity
-      Error(Nil) -> 0
-    }
-    before + item.quantity >= bought
+  let returning =
+    list.fold(items, dict.new(), fn(acc, item) {
+      dict.upsert(acc, item.sku, fn(quantity) {
+        case quantity {
+          Some(quantity) -> quantity + item.quantity
+          None -> item.quantity
+        }
+      })
+    })
+  list.all(order.lines, fn(line) {
+    let before = dict.get(already_returned, line.sku) |> result.unwrap(0)
+    let now = dict.get(returning, line.sku) |> result.unwrap(0)
+    before + now >= line.quantity
   })
 }
 
