+fn category_subtotals(
+  products: Dict(String, catalog.Product),
+  lines: List(order.Line),
+) -> List(#(catalog.Category, Int)) {
+  list.fold(lines, [], fn(subtotals, line) {
+    case catalog.category_of(products, line.sku) {
+      Ok(category) ->
+        add_category_subtotal(
+          subtotals,
+          category,
+          line.quantity * line.unit_price_cents,
+        )
+      Error(_) -> subtotals
+    }
+  })
+}
+
+fn add_category_subtotal(
+  subtotals: List(#(catalog.Category, Int)),
+  category: catalog.Category,
+  amount_cents: Int,
+) -> List(#(catalog.Category, Int)) {
+  case list.find(subtotals, fn(entry) { entry.0 == category }) {
+    Ok(_) ->
+      list.map(subtotals, fn(entry) {
+        case entry.0 == category {
+          True -> #(category, entry.1 + amount_cents)
+          False -> entry
+        }
+      })
+    Error(_) -> [#(category, amount_cents), ..subtotals]
+  }
+}
