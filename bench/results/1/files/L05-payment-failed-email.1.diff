+fn record_payment_failure(
+  db: Store,
+  order_id: Int,
+  attempts: Int,
+  now: Int,
+) -> Store {
+  case store.get_order(db, order_id) {
+    Ok(existing) ->
+      case store.get_customer(db, existing.customer_id) {
+        Ok(customer) ->
+          db
+          |> store.send(notifications.payment_failed(
+            customer,
+            existing,
+            attempts,
+            now,
+          ))
+          |> store.record(
+            now,
+            actor,
+            "payment failed",
+            audit.order_subject(order_id),
+            "",
+          )
+        Error(Nil) -> db
+      }
+    Error(Nil) -> db
+  }
+}
