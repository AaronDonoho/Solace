+  let assert Ok(#(db, _)) = returns.approve(db, april, second.id)
+  let assert Ok(#(db, _)) = returns.receive(db, april, second.id)
+  let assert Ok(#(db, second)) =
+    returns.refund(db, april, payments.fake_gateway(), second.id)
+
+  let #(db, pending_order, _) =
+    support.delivered(db, seed.ada, [#("MUG-BLUE", 1)], 3)
+  let assert Ok(#(db, _)) =
+    returns.request(db, april, pending_order.id, [Item("MUG-BLUE", 1)], Damaged)
+
+  assert reporting.refunds_by_month(db)
+    == [
+      MonthlyRefunds("2026-03", "no longer needed", 1, first.refund.total_cents),
+      MonthlyRefunds("2026-04", "damaged", 1, second.refund.total_cents),
+    ]
+}
