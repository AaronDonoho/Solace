+      march,
+      first_order.id,
+      [Item("TEE-M-BLK", 1)],
+      NoLongerNeeded,
+    )
+  let assert Ok(#(db, _)) = returns.approve(db, march, first.id)
+  let assert Ok(#(db, _)) = returns.receive(db, march, first.id)
+  let assert Ok(#(db, first)) =
+    returns.refund(db, march, payments.fake_gateway(), first.id)
+
+  let #(db, second_order, _) =
+    support.delivered(db, seed.ada, [#("MUG-BLUE", 1)], 3)
+  let april = support.on_day(31)
