+pub fn refunds_by_month_test() {
+  let #(db, first_order, _) =
+    support.delivered(seed.demo_store(), seed.ada, [#("TEE-M-BLK", 1)], 3)
+  let march = support.on_day(5)
+  let assert Ok(#(db, first)) =
+    returns.request(
