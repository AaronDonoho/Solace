@@ -203,3 +203,52 @@ pub fn sales_summary(db: Store, from: Date, to: Date) -> String {
   <> money.format(sum(fn(d) { d.net_cents }))
   <> "\n"
 }
+
+pub type MonthlyRefunds {
+  MonthlyRefunds(
+    month: String,
+    reason: String,
+    returns: Int,
+    refunded_cents: Int,
+  )
+}
+
+/// Refunded returns grouped by UTC refund month and reason.
+pub fn refunds_by_month(db: Store) -> List(MonthlyRefunds) {
+  db.returns
+  |> dict.values
+  |> list.filter_map(fn(r) {
+    case r.status, r.refunded_at {
+      return_policy.Refunded, Some(refunded_at) -> {
+        let date.Date(year, month, _) = date.from_unix_ms(refunded_at)
+        let month =
+          string.pad_start(int.to_string(year), 4, "0")
+          <> "-"
+          <> string.pad_start(int.to_string(month), 2, "0")
+        Ok(#(r, month))
+      }
+      _, _ -> Error(Nil)
+    }
+  })
+  |> list.group(fn(row) {
+    #(row.1, return_policy.reason_name({ row.0 }.reason))
+  })
+  |> dict.to_list
+  |> list.map(fn(pair) {
+    let #(month, reason) = pair.0
+    MonthlyRefunds(
+      month:,
+      reason:,
+      returns: list.length(pair.1),
+      refunded_cents: money.sum(
+        list.map(pair.1, fn(row) { { row.0 }.refund.total_cents }),
+      ),
+    )
+  })
+  |> list.sort(fn(a, b) {
+    case string.compare(a.month, b.month) {
+      ordering.Eq -> string.compare(a.reason, b.reason)
+      other -> other
+    }
+  })
+}
