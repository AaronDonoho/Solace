diff --git a/src/pilot/return_policy.gleam b/src/pilot/return_policy.gleam
index cd15ae9..c099d75 100644
--- a/src/pilot/return_policy.gleam
+++ b/src/pilot/return_policy.gleam
@@ -139,18 +139,20 @@ pub fn restocking_fee_percent(category: Category, reason: Reason) -> Int {
 }
 
 /// True when, after this return, every unit of the order has been returned.
+/// Every line of the order is checked: units kept on any line leave the
+/// order unfinished, so a return that empties only some lines is partial.
 pub fn completes_order(
   order: Order,
   items: List(Item),
   already_returned: Dict(String, Int),
 ) -> Bool {
-  list.all(items, fn(item) {
-    let before = dict.get(already_returned, item.sku) |> result.unwrap(0)
-    let bought = case order.find_line(order, item.sku) {
-      Ok(line) -> line.quantity
-      Error(Nil) -> 0
-    }
-    before + item.quantity >= bought
+  list.all(order.lines, fn(line) {
+    let before = dict.get(already_returned, line.sku) |> result.unwrap(0)
+    let now =
+      items
+      |> list.filter(fn(item) { item.sku == line.sku })
+      |> list.fold(0, fn(total, item) { total + item.quantity })
+    before + now >= line.quantity
   })
 }
 
diff --git a/test/pilot/return_policy_test.gleam b/test/pilot/return_policy_test.gleam
index d524f34..af47ebb 100644
--- a/test/pilot/return_policy_test.gleam
+++ b/test/pilot/return_policy_test.gleam
@@ -102,3 +102,28 @@ pub fn restocking_fee_test() {
   assert return_policy.restocking_fee_percent(Electronics, Damaged) == 0
   assert return_policy.restocking_fee_percent(Apparel, NoLongerNeeded) == 0
 }
+
+pub fn completes_order_test() {
+  let o = delivered_on(0)
+  let none = dict.new()
+  // Emptying one line while another line's units stay is a partial return.
+  assert return_policy.completes_order(o, [Item("TEE", 2)], none) == False
+  assert return_policy.completes_order(o, [Item("MUG", 1)], none) == False
+  assert return_policy.completes_order(
+      o,
+      [Item("TEE", 1), Item("MUG", 1)],
+      none,
+    )
+    == False
+  // The units already returned count towards the lines they cover.
+  assert return_policy.completes_order(
+    o,
+    [Item("MUG", 1)],
+    dict.from_list([#("TEE", 2)]),
+  )
+  assert return_policy.completes_order(
+    o,
+    [Item("TEE", 2), Item("MUG", 1)],
+    none,
+  )
+}
