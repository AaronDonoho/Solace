+
+pub fn partial_return_keeps_shipping_test() {
+  let #(db, o, _) =
+    support.delivered(
+      seed.demo_store(),
+      seed.ada,
+      [#("TEE-M-BLK", 2), #("MUG-BLUE", 1)],
+      3,
+    )
+  let c = support.on_day(5)
+  // Both shirts go back, the mug stays: shipping is not owed back.
+  let assert Ok(#(_, r)) =
+    returns.request(db, c, o.id, [Item("TEE-M-BLK", 2)], NoLongerNeeded)
+  assert r.refund.shipping_cents == 0
+  assert r.refund.total_cents == 3761
+}
