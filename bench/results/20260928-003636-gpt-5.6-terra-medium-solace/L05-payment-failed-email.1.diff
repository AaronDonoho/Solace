+pub fn payment_failed(
+  customer: Customer,
+  order_id: Int,
+  attempts: Int,
+  now: Int,
+) -> Message {
+  Message(
+    to: customer.email,
+    subject: "Payment failed for your " <> order_ref(order_id),
+    body: greeting(customer)
+      <> "We couldn't process the payment for your order. Please try again.\n"
+      <> "Attempts: "
+      <> int.to_string(attempts)
+      <> "\n",
+    kind: PaymentFailed,
+    order_id:,
+    created_at: now,
+  )
+}
