@@ -108,11 +108,29 @@ pub fn add_days(date: Date, days: Int) -> Date {
 /// The date `days` business days after `date`, skipping Saturdays and
 /// Sundays. Starting on a weekend counts from the following Monday.
 pub fn add_business_days(date: Date, days: Int) -> Date {
+  case days <= 0 {
+    True -> date
+    False -> step_business_days(roll_to_weekday(date), days)
+  }
+}
+
+fn roll_to_weekday(date: Date) -> Date {
+  case weekday(date) {
+    Saturday -> add_days(date, 2)
+    Sunday -> add_days(date, 1)
+    _ -> date
+  }
+}
+
+fn step_business_days(date: Date, days: Int) -> Date {
   case days <= 0 {
     True -> date
     False -> {
       let next = add_days(date, 1)
-      add_business_days(next, days - 1)
+      case is_weekend(next) {
+        True -> step_business_days(next, days)
+        False -> step_business_days(next, days - 1)
+      }
     }
   }
 }
