diff --git a/solace.toml b/solace.toml
new file mode 100644
index 0000000..bac0ebb
--- /dev/null
+++ b/solace.toml
@@ -0,0 +1,13 @@
+# Solace project settings. Protected: agents may read this file.
+# Text files up to this many bytes are watched; file writes are limited to it.
+watch_limit = 262144
+# Files Solace doesn't watch or search (agents can still read and write them).
+unwatched = []
+
+[validators]
+# Optional checks, for example:
+# "docs/**/*.json" = ["python3", "-m", "json.tool", "{file}"]
+
+[commands]
+# Optional commands agents may run, for example:
+# app = { run = ["gleam", "run", "--"], args = true }
diff --git a/src/pilot/date.gleam b/src/pilot/date.gleam
index eb788e7..179789c 100644
--- a/src/pilot/date.gleam
+++ b/src/pilot/date.gleam
@@ -110,10 +110,7 @@ pub fn add_days(date: Date, days: Int) -> Date {
 pub fn add_business_days(date: Date, days: Int) -> Date {
   case days <= 0 {
     True -> date
-    False -> {
-      let next = add_days(date, 1)
-      add_business_days(next, days - 1)
-    }
+    False -> step_business_days(roll_to_weekday(date), days)
   }
 }
 
@@ -133,3 +130,23 @@ pub fn to_iso(date: Date) -> String {
   <> "-"
   <> string.pad_start(int.to_string(date.day), 2, "0")
 }
+
+/// 0 for Monday through 6 for Sunday (1970-01-01 was a Thursday).
+fn weekday_index(date: Date) -> Int {
+  { to_days(date) + 3 } % 7
+}
+
+fn roll_to_weekday(date: Date) -> Date {
+  case weekday_index(date) {
+    5 -> add_days(date, 2)
+    6 -> add_days(date, 1)
+    _ -> date
+  }
+}
+
+fn step_business_days(date: Date, days: Int) -> Date {
+  case days <= 0 {
+    True -> date
+    False -> step_business_days(roll_to_weekday(add_days(date, 1)), days - 1)
+  }
+}
diff --git a/test/pilot/date_test.gleam b/test/pilot/date_test.gleam
index 7cb0319..9e7f80b 100644
--- a/test/pilot/date_test.gleam
+++ b/test/pilot/date_test.gleam
@@ -29,3 +29,10 @@ pub fn days_between_and_iso_test() {
   assert date.days_between(Date(2026, 2, 27), Date(2026, 3, 2)) == 3
   assert date.to_iso(Date(2026, 3, 2)) == "2026-03-02"
 }
+
+pub fn business_days_skip_weekend_test() {
+  // Thursday 2026-03-05 + 4 business days = Wednesday 2026-03-11
+  assert date.add_business_days(Date(2026, 3, 5), 4) == Date(2026, 3, 11)
+  // Saturday counts from the following Monday
+  assert date.add_business_days(Date(2026, 3, 7), 1) == Date(2026, 3, 10)
+}
