+
+pub fn partial_return_does_not_complete_order_test() {
+  let o = delivered_on(0)
+  assert !return_policy.completes_order(o, [Item("TEE", 2)], dict.new())
+  assert return_policy.completes_order(
+    o,
+    [Item("MUG", 1)],
+    dict.from_list([#("TEE", 2)]),
+  )
+}
