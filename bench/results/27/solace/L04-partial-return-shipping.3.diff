diff --git a/src/pilot/return_policy.gleam b/src/pilot/return_policy.gleam
index cd15ae9..afdb23a 100644
--- a/src/pilot/return_policy.gleam
+++ b/src/pilot/return_policy.gleam
@@ -139,18 +139,28 @@ pub fn restocking_fee_percent(category: Category, reason: Reason) -> Int {
 }
 
 /// True when, after this return, every unit of the order has been returned.
+/// Every line of the order is checked: returning all of one line's units
+/// leaves the order only partly returned.
 pub fn completes_order(
   order: Order,
   items: List(Item),
   already_returned: Dict(String, Int),
 ) -> Bool {
-  list.all(items, fn(item) {
-    let before = dict.get(already_returned, item.sku) |> result.unwrap(0)
-    let bought = case order.find_line(order, item.sku) {
-      Ok(line) -> line.quantity
-      Error(Nil) -> 0
-    }
-    before + item.quantity >= bought
+  let this_return =
+    items
+    |> list.fold(dict.new(), fn(counts, item) {
+      dict.upsert(counts, item.sku, fn(seen) {
+        case seen {
+          Some(seen) -> seen + item.quantity
+          None -> item.quantity
+        }
+      })
+    })
+  order.lines != []
+  && list.all(order.lines, fn(line) {
+    let before = dict.get(already_returned, line.sku) |> result.unwrap(0)
+    let now = dict.get(this_return, line.sku) |> result.unwrap(0)
+    before + now >= line.quantity
   })
 }
 
diff --git a/test/pilot/return_policy_test.gleam b/test/pilot/return_policy_test.gleam
index d524f34..5d3dc7c 100644
--- a/test/pilot/return_policy_test.gleam
+++ b/test/pilot/return_policy_test.gleam
@@ -102,3 +102,52 @@ pub fn restocking_fee_test() {
   assert return_policy.restocking_fee_percent(Electronics, Damaged) == 0
   assert return_policy.restocking_fee_percent(Apparel, NoLongerNeeded) == 0
 }
+
+pub fn completes_order_test() {
+  let o = delivered_on(0)
+  // Returning every unit of one line is not the whole order.
+  assert return_policy.completes_order(o, [Item("TEE", 2)], dict.new()) == False
+  assert return_policy.completes_order(o, [Item("MUG", 1)], dict.new()) == False
+  assert return_policy.completes_order(
+      o,
+      [Item("TEE", 1), Item("MUG", 1)],
+      dict.new(),
+    )
+    == False
+  // A return that covers every line.
+  let everything = [Item("TEE", 2), Item("MUG", 1)]
+  assert return_policy.completes_order(o, everything, dict.new())
+  // Every line, counting units already returned on earlier returns.
+  assert return_policy.completes_order(
+    o,
+    [Item("MUG", 1)],
+    dict.from_list([#("TEE", 2)]),
+  )
+  assert return_policy.completes_order(
+    o,
+    [Item("TEE", 1), Item("MUG", 1)],
+    dict.from_list([#("TEE", 1)]),
+  )
+  // A line left short of what was bought keeps the order partly returned.
+  assert return_policy.completes_order(
+      o,
+      [Item("TEE", 1)],
+      dict.from_list([#("TEE", 1)]),
+    )
+    == False
+}
+
+pub fn partial_line_return_excludes_shipping_test() {
+  // All of the T-shirts, keeping the mug: shipping stays with the order.
+  let items = [Item("TEE", 2)]
+  let whole = return_policy.completes_order(delivered_on(0), items, dict.new())
+  assert return_policy.refund_amount(
+      delivered_on(0),
+      quote(),
+      items,
+      dict.from_list([#("TEE", Apparel)]),
+      Damaged,
+      whole,
+    )
+    == RefundBreakdown(3600, 0, 161, 0, 0, 3761)
+}
