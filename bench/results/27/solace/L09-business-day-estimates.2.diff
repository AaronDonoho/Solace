--- a/src/pilot/date.gleam
+++ b/src/pilot/date.gleam
@@ -108,13 +108,7 @@ pub fn add_days(date: Date, days: Int) -> Date {
 /// The date `days` business days after `date`, skipping Saturdays and
 /// Sundays. Starting on a weekend counts from the following Monday.
 pub fn add_business_days(date: Date, days: Int) -> Date {
-  case days <= 0 {
-    True -> date
-    False -> {
-      let next = add_days(date, 1)
-      add_business_days(next, days - 1)
-    }
-  }
+  count_business_days(start_of_count(date), days)
 }
 
 pub fn days_between(from: Date, to: Date) -> Int {
@@ -133,3 +127,34 @@ pub fn to_iso(date: Date) -> String {
   <> "-"
   <> string.pad_start(int.to_string(date.day), 2, "0")
 }
+
+/// The business day the count starts on: `date` itself, or the Monday
+/// after it when `date` falls on a weekend.
+fn start_of_count(date: Date) -> Date {
+  add_days(date, days_until_monday(date))
+}
+
+/// Calendar days from `date` to the Monday that opens the next business
+/// week; 0 when `date` is already a business day.
+fn days_until_monday(date: Date) -> Int {
+  case weekday(date) {
+    Saturday -> 2
+    Sunday -> 1
+    _ -> 0
+  }
+}
+
+/// The business day after the business day `date`: the following day, or
+/// Monday when that day is a Saturday.
+fn next_business_day(date: Date) -> Date {
+  let next = add_days(date, 1)
+  add_days(next, days_until_monday(next))
+}
+
+/// The business day `days` business days after the business day `date`.
+fn count_business_days(date: Date, days: Int) -> Date {
+  case days <= 0 {
+    True -> date
+    False -> count_business_days(next_business_day(date), days - 1)
+  }
+}
diff --git a/test/pilot/date_test.gleam b/test/pilot/date_test.gleam
index 7cb0319..58bd582 100644
--- a/test/pilot/date_test.gleam
+++ b/test/pilot/date_test.gleam
@@ -23,9 +23,31 @@ pub fn business_days_test() {
   // Monday + 3 business days = Thursday
   assert date.add_business_days(Date(2026, 3, 2), 3) == Date(2026, 3, 5)
   assert date.add_business_days(Date(2026, 3, 2), 0) == Date(2026, 3, 2)
+  // A full business week from Monday is the following Monday
+  assert date.add_business_days(Date(2026, 3, 2), 4) == Date(2026, 3, 6)
+  assert date.add_business_days(Date(2026, 3, 2), 5) == Date(2026, 3, 9)
 }
 
 pub fn days_between_and_iso_test() {
   assert date.days_between(Date(2026, 2, 27), Date(2026, 3, 2)) == 3
   assert date.to_iso(Date(2026, 3, 2)) == "2026-03-02"
 }
+
+pub fn business_days_skip_weekend_test() {
+  // Thursday 2026-03-05 + 4 business days: Fri, Mon, Tue, Wed
+  assert date.add_business_days(Date(2026, 3, 5), 4) == Date(2026, 3, 11)
+  // Friday + 1 business day is Monday, not Saturday
+  assert date.add_business_days(Date(2026, 3, 6), 1) == Date(2026, 3, 9)
+  // Friday + 3 business days skips the whole weekend
+  assert date.add_business_days(Date(2026, 3, 6), 3) == Date(2026, 3, 11)
+  // 10 business days from Wednesday 2026-03-04 skips two weekends
+  assert date.add_business_days(Date(2026, 3, 4), 10) == Date(2026, 3, 18)
+}
+
+pub fn business_days_from_weekend_test() {
+  // Starting on a weekend counts from the following Monday
+  assert date.add_business_days(Date(2026, 3, 7), 0) == Date(2026, 3, 9)
+  assert date.add_business_days(Date(2026, 3, 7), 1) == Date(2026, 3, 10)
+  assert date.add_business_days(Date(2026, 3, 8), 1) == Date(2026, 3, 10)
+  assert date.add_business_days(Date(2026, 3, 7), 4) == Date(2026, 3, 13)
+}
