+pub fn shipped_email_skips_the_weekend_test() {
+  // Ada's order ships from Newark (NJ) to Albany (NY): national standard.
+  let #(db, o) = support.paid(seed.demo_store(), seed.ada, [#("MUG-BLUE", 1)])
+  // Day 3 after the seed epoch (Monday 2026-03-02) is Thursday 2026-03-05.
+  let #(db, _shipment) = support.shipped_on(db, o.id, 3)
+  let assert Ok(message) =
+    list.find(store.sent_messages(db), fn(m) {
+      m.kind == notifications.OrderShipped
+    })
+  // 4 business days from Thursday: Fri 6, Mon 9, Tue 10, Wed 11.
+  assert string.contains(message.body, "should arrive by 2026-03-11")
+}
diff --git a/test/pilot/tax_shipping_test.gleam b/test/pilot/tax_shipping_test.gleam
index fd9bee7..e18ad11 100644
--- a/test/pilot/tax_shipping_test.gleam
+++ b/test/pilot/tax_shipping_test.gleam
@@ -46,4 +46,15 @@ pub fn estimate_delivery_test() {
   // Shipped Monday 2026-03-02, national standard: 4 business days
   let q = shipping.quote(Standard, "NJ", Domestic("NY"), 850, 0)
   assert shipping.estimate_delivery(Date(2026, 3, 2), q) == Date(2026, 3, 6)
+  // Shipped Thursday 2026-03-05, national standard: 4 business days, and the
+  // weekend is skipped: Fri 6, Mon 9, Tue 10, Wed 11.
+  assert shipping.estimate_delivery(Date(2026, 3, 5), q) == Date(2026, 3, 11)
+  // Express national from a Thursday: 2 business days lands on Monday
+  let express = shipping.quote(Express, "NJ", Domestic("NY"), 850, 0)
+  assert shipping.estimate_delivery(Date(2026, 3, 5), express)
+    == Date(2026, 3, 9)
+  // Overseas standard from a Thursday: 10 business days
+  let overseas = shipping.quote(Standard, "NJ", International("DE"), 850, 0)
+  assert shipping.estimate_delivery(Date(2026, 3, 5), overseas)
+    == Date(2026, 3, 19)
 }
