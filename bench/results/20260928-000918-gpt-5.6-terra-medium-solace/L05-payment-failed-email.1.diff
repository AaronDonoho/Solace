+
+pub fn payment_failed(
+  customer: Customer,
+  order: Order,
+  attempts: Int,
+  now: Int,
+) -> Message {
+  Message(
+    to: customer.email,
+    subject: "Payment failed for your " <> order_ref(order.id),
+    body: greeting(customer)
+      <> "We couldn't process your payment. Please try again.\n"
+      <> "Attempts: "
+      <> int.to_string(attempts)
+      <> "\n",
+    kind: PaymentFailed,
+    order_id: order.id,
+    created_at: now,
+  )
+}
