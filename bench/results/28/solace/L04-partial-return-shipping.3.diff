diff --git a/src/pilot/return_policy.gleam b/src/pilot/return_policy.gleam
index cd15ae9..bc889d7 100644
--- a/src/pilot/return_policy.gleam
+++ b/src/pilot/return_policy.gleam
@@ -138,19 +138,22 @@ pub fn restocking_fee_percent(category: Category, reason: Reason) -> Int {
   }
 }
 
-/// True when, after this return, every unit of the order has been returned.
+/// True when, after this return, every unit of every line of the order has
+/// been returned. Lines not covered by this return count only what earlier
+/// returns covered, so returning one whole line of a multi-line order does
+/// not complete the order.
 pub fn completes_order(
   order: Order,
   items: List(Item),
   already_returned: Dict(String, Int),
 ) -> Bool {
-  list.all(items, fn(item) {
-    let before = dict.get(already_returned, item.sku) |> result.unwrap(0)
-    let bought = case order.find_line(order, item.sku) {
-      Ok(line) -> line.quantity
-      Error(Nil) -> 0
-    }
-    before + item.quantity >= bought
+  list.all(order.lines, fn(line) {
+    let before = dict.get(already_returned, line.sku) |> result.unwrap(0)
+    let this_return =
+      items
+      |> list.filter(fn(item) { item.sku == line.sku })
+      |> list.fold(0, fn(total, item) { total + item.quantity })
+    before + this_return >= line.quantity
   })
 }
 
diff --git a/test/pilot/return_policy_test.gleam b/test/pilot/return_policy_test.gleam
index d524f34..159a38f 100644
--- a/test/pilot/return_policy_test.gleam
+++ b/test/pilot/return_policy_test.gleam
@@ -102,3 +102,31 @@ pub fn restocking_fee_test() {
   assert return_policy.restocking_fee_percent(Electronics, Damaged) == 0
   assert return_policy.restocking_fee_percent(Apparel, NoLongerNeeded) == 0
 }
+
+pub fn completes_order_test() {
+  let o = delivered_on(0)
+  let none = dict.new()
+  // Every unit of every line, in one return.
+  assert return_policy.completes_order(
+    o,
+    [Item("TEE", 2), Item("MUG", 1)],
+    none,
+  )
+  // Every unit of one line, keeping the other line: the order is not complete.
+  assert !return_policy.completes_order(o, [Item("TEE", 2)], none)
+  assert !return_policy.completes_order(o, [Item("MUG", 1)], none)
+  // A partial return of a line.
+  assert !return_policy.completes_order(o, [Item("TEE", 1)], none)
+  // The last line's units, on top of an earlier return that covered the rest.
+  assert return_policy.completes_order(
+    o,
+    [Item("MUG", 1)],
+    dict.from_list([#("TEE", 2)]),
+  )
+  // An earlier return that only covered part of a line leaves the order open.
+  assert !return_policy.completes_order(
+    o,
+    [Item("MUG", 1)],
+    dict.from_list([#("TEE", 1)]),
+  )
+}
diff --git a/test/pilot/returns_test.gleam b/test/pilot/returns_test.gleam
index 5cf865d..7522122 100644
--- a/test/pilot/returns_test.gleam
+++ b/test/pilot/returns_test.gleam
@@ -102,3 +102,25 @@ pub fn must_receive_before_refund_test() {
     returns.refund(db, c, gateway(), r.id)
   assert inventory.available(db.stock, "WH-EAST", "MUG-BLUE") == 29
 }
+
+pub fn partial_return_keeps_shipping_test() {
+  let #(db, o, _) =
+    support.delivered(
+      seed.demo_store(),
+      seed.ada,
+      [#("TEE-M-BLK", 2), #("MUG-BLUE", 1)],
+      3,
+    )
+  let c = support.on_day(5)
+  // The ticket: both T-shirts back, the mug kept. 2 x 1800 goods, no
+  // discount, their share of the 224 tax (224 * 3600 / 5000 = 161), no
+  // restocking fee on apparel, and no shipping.
+  let assert Ok(#(db, shirts)) =
+    returns.request(db, c, o.id, [Item("TEE-M-BLK", 2)], Damaged)
+  assert shirts.refund.shipping_cents == 0
+  assert shirts.refund.total_cents == 3761
+  // Returning the mug as well is what completes the order and refunds shipping.
+  let assert Ok(#(_, mug)) =
+    returns.request(db, c, o.id, [Item("MUG-BLUE", 1)], Damaged)
+  assert mug.refund.shipping_cents == 600
+}
