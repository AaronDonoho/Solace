diff --git a/test/pilot/checkout_test.gleam b/test/pilot/checkout_test.gleam
index a9a0fa4..18b8ce5 100644
--- a/test/pilot/checkout_test.gleam
+++ b/test/pilot/checkout_test.gleam
@@ -174,3 +174,26 @@ pub fn origin_warehouse_test() {
   assert checkout.origin_warehouse([], customer.Domestic("CA"))
     == Error(checkout.NoWarehouse)
 }
+
+pub fn quote_skips_tax_for_exempt_customer_test() {
+  let base = seed.demo_store()
+  let assert Ok(ada) = store.get_customer(base, seed.ada)
+  let db = store.put_customer(base, customer.Customer(..ada, tax_exempt: True))
+  let #(db, o) =
+    support.draft(db, seed.ada, [#("TEE-M-BLK", 2), #("MUG-BLUE", 1)])
+  let assert Ok(q) = checkout.quote(db, o.id, Standard)
+  assert q.subtotal_cents == 5000
+  assert q.shipping_cents == 600
+  assert q.tax_cents == 0
+  assert q.total_cents == 5600
+}
+
+pub fn pay_charges_no_tax_for_exempt_customer_test() {
+  let base = seed.demo_store()
+  let assert Ok(ada) = store.get_customer(base, seed.ada)
+  let db = store.put_customer(base, customer.Customer(..ada, tax_exempt: True))
+  let #(db, o) =
+    support.paid(db, seed.ada, [#("TEE-M-BLK", 2), #("MUG-BLUE", 1)])
+  let assert Ok(p) = store.payment_for_order(db, o.id)
+  assert p.amount_cents == 5600
+}
