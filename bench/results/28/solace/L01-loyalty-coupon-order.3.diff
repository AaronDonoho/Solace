@@ -77,3 +79,37 @@ pub fn free_shipping_coupon_test() {
   assert q.shipping_cents == 0
   assert q.tax_cents == 40
 }
+
+pub fn loyalty_applied_before_fixed_coupon_test() {
+  // Gold 5% comes off the full price first: 7400 - 370 = 7030, then the
+  // $10 coupon takes it to 6030.
+  let q =
+    pricing.quote(
+      [Line("L", 1, 7400)],
+      Gold,
+      Some(coupon(FixedOff(1000), True)),
+      ship(600),
+      Domestic("CA"),
+    )
+  assert q.loyalty_discount_cents == 370
+  assert q.coupon_discount_cents == 1000
+  assert pricing.goods_cents(q) == 6030
+  assert q.total_cents == 6030 + 600 + 437
+}
+
+pub fn fixed_coupon_caps_at_post_loyalty_goods_test() {
+  // A coupon bigger than what loyalty left behind cannot take the goods
+  // below zero: 1000 - 50 loyalty = 950, and the coupon is capped there.
+  let q =
+    pricing.quote(
+      [Line("L", 1, 1000)],
+      Gold,
+      Some(coupon(FixedOff(2000), True)),
+      ship(0),
+      Domestic("OR"),
+    )
+  assert q.loyalty_discount_cents == 50
+  assert q.coupon_discount_cents == 950
+  assert pricing.goods_cents(q) == 0
+  assert q.total_cents == 0
+}
