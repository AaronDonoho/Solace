diff --git a/test/pilot/checkout_test.gleam b/test/pilot/checkout_test.gleam
index a9a0fa4..d32fe46 100644
--- a/test/pilot/checkout_test.gleam
+++ b/test/pilot/checkout_test.gleam
@@ -174,3 +174,16 @@ pub fn origin_warehouse_test() {
   assert checkout.origin_warehouse([], customer.Domestic("CA"))
     == Error(checkout.NoWarehouse)
 }
+
+pub fn gold_loyalty_before_coupon_test() {
+  // Support ticket: Grace (Gold), one Desk Lamp, TENOFF, standard shipping.
+  // 7400 - 370 loyalty - 1000 coupon = 6030 goods, + 600 shipping + 437 tax.
+  let #(db, o) =
+    support.draft(seed.demo_store(), seed.grace, [#("LAMP-OAK", 1)])
+  let c = support.on_day(0)
+  let assert Ok(#(db, _)) = checkout.apply_coupon(db, c, o.id, "TENOFF")
+  let assert Ok(q) = checkout.quote(db, o.id, Standard)
+  assert q.loyalty_discount_cents == 370
+  assert q.coupon_discount_cents == 1000
+  assert q.total_cents == 7067
+}
