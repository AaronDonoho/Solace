+pub fn shipped_email_estimate_skips_weekend_test() {
+  let #(db, o) = support.paid(seed.demo_store(), seed.ada, [#("MUG-BLUE", 1)])
+  // Shipped Thursday 2026-03-05 (day 3) from New Jersey to New York.
+  let #(db, _) = support.shipped_on(db, o.id, 3)
+  let assert Ok(message) =
+    list.find(store.sent_messages(db), fn(m) {
+      m.kind == notifications.OrderShipped
+    })
+  // Standard shipping takes 4 business days: Fri, Mon, Tue, Wed.
+  assert string.contains(message.body, "should arrive by 2026-03-11")
+}
diff --git a/test/pilot/tax_shipping_test.gleam b/test/pilot/tax_shipping_test.gleam
index fd9bee7..5e98ba4 100644
--- a/test/pilot/tax_shipping_test.gleam
+++ b/test/pilot/tax_shipping_test.gleam
@@ -46,4 +46,12 @@ pub fn estimate_delivery_test() {
   // Shipped Monday 2026-03-02, national standard: 4 business days
   let q = shipping.quote(Standard, "NJ", Domestic("NY"), 850, 0)
   assert shipping.estimate_delivery(Date(2026, 3, 2), q) == Date(2026, 3, 6)
+
+  // Shipped Thursday 2026-03-05, national standard: Fri, Mon, Tue, Wed
+  assert shipping.estimate_delivery(Date(2026, 3, 5), q) == Date(2026, 3, 11)
+  // Shipped Saturday: the count starts on the following Monday
+  assert shipping.estimate_delivery(Date(2026, 3, 7), q) == Date(2026, 3, 12)
+  // Express local is 1 business day; shipped Friday, it arrives Monday
+  let e = shipping.quote(Express, "NJ", Domestic("NJ"), 850, 0)
+  assert shipping.estimate_delivery(Date(2026, 3, 6), e) == Date(2026, 3, 9)
 }
