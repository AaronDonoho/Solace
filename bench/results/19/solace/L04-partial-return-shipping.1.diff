+  list.all(order.lines, fn(line) {
+    let before = dict.get(already_returned, line.sku) |> result.unwrap(0)
+    let in_this_return =
+      list.fold(items, 0, fn(quantity, item) {
+        case item.sku == line.sku {
+          True -> quantity + item.quantity
+          False -> quantity
+        }
+      })
+    before + in_this_return >= line.quantity
   })
 }
 
