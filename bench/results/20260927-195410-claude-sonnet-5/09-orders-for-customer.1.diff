+/// Returns every order for a customer, newest first by creation time, with
+/// ties broken by order id (highest first).
+pub fn orders_for(
+  db: Store,
+  customer_id: Int,
+) -> Result(List(Order), CheckoutError) {
+  use _ <- result.try(
+    store.get_customer(db, customer_id)
+    |> result.replace_error(UnknownCustomer(customer_id)),
+  )
+  let orders =
+    db.orders
+    |> dict.values
+    |> list.filter(fn(o) { o.customer_id == customer_id })
+  Ok(
+    list.sort(orders, fn(a, b) {
+      int.compare(b.created_at, a.created_at)
+      |> ordering.break_tie(int.compare(b.id, a.id))
+    }),
+  )
+}
