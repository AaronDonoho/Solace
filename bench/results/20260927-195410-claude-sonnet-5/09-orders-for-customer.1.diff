+}
+
+pub fn orders_for_sorts_newest_first_with_id_tiebreak_test() {
+  let db =
+    setup()
+    |> store.put_customer(Customer(2, "Bob", Domestic))
+  let assert Ok(#(db, first)) =
+    checkout.create_order(db, clock.fixed(now), 1)
+  let assert Ok(#(db, _other_customer)) =
+    checkout.create_order(db, clock.fixed(now), 2)
+  let assert Ok(#(db, second)) =
+    checkout.create_order(db, clock.fixed(now + 1), 1)
+  let assert Ok(#(db, third)) =
+    checkout.create_order(db, clock.fixed(now + 1), 1)
+
+  let assert Ok(orders) = checkout.orders_for(db, 1)
+  assert orders == [third, second, first]
+}
