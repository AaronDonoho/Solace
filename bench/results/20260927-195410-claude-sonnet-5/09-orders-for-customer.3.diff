+/// Returns a customer's orders, newest first, ties broken by order id.
+pub fn orders_for(
+  db: Store,
+  customer_id: Int,
+) -> Result(List(Order), CheckoutError) {
+  use _ <- result.try(
+    store.get_customer(db, customer_id)
+    |> result.replace_error(UnknownCustomer(customer_id)),
+  )
+  let orders =
+    store.orders_for_customer(db, customer_id)
+    |> list.sort(by: fn(a, b) {
+      int.compare(a.created_at, b.created_at)
+      |> ord.break_tie(with: int.compare(a.id, b.id))
+      |> ord.negate
+    })
+  Ok(orders)
+}
