+pub fn orders_for_returns_newest_first_with_id_tiebreak_test() {
+  let db =
+    setup()
+    |> store.put_customer(Customer(2, "Bo", Domestic))
+  let assert Ok(#(db, first)) = checkout.create_order(db, clock.fixed(now), 1)
+  let assert Ok(#(db, tie)) =
+    checkout.create_order(db, clock.fixed(now + 10), 1)
+  let assert Ok(#(db, tie2)) =
+    checkout.create_order(db, clock.fixed(now + 10), 1)
+  let assert Ok(#(db, latest)) =
+    checkout.create_order(db, clock.fixed(now + 20), 1)
+  let assert Ok(#(db, _other_customer)) =
+    checkout.create_order(db, clock.fixed(now + 30), 2)
+
+  let assert Ok(orders) = checkout.orders_for(db, 1)
+  assert orders == [latest, tie2, tie, first]
+}
+
+pub fn orders_for_unknown_customer_test() {
+  assert checkout.orders_for(setup(), 99) == Error(UnknownCustomer(99))
+}
