+pub fn refund_returns_stock_test() {
+  let c = clock.fixed(now)
+  let assert Ok(#(db, o)) = checkout.create_order(setup(), c, 1)
+  let assert Ok(#(db, _)) = checkout.add_line(db, c, o.id, "A", 3)
+  let assert Ok(#(db, _)) = checkout.submit(db, c, o.id)
+  let assert Ok(#(db, _)) = checkout.approve(db, c, o.id)
+  let assert Ok(a) = store.get_product(db, "A")
+  assert a.stock == 2
+  let assert Ok(#(db, _)) = checkout.ship(db, c, o.id)
+  let assert Ok(#(db, o)) = checkout.refund(db, c, o.id)
+  assert o.status == Refunded
+  let assert Ok(a) = store.get_product(db, "A")
+  assert a.stock == 5
+}
+
+pub fn refund_fails_when_not_shipped_test() {
+  let c = clock.fixed(now)
+  let assert Ok(#(db, o)) = checkout.create_order(setup(), c, 1)
+  assert checkout.refund(db, c, o.id)
+    == Error(Rejected(order.InvalidTransition(
+      from: order.Draft,
+      action: order.Refund,
+    )))
+}
