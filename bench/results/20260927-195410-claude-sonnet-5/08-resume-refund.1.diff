+/// Refunds a shipped order, returning stock for every line to inventory.
+pub fn refund(
+  db: Store,
+  clock: Clock,
+  order_id: Int,
+) -> Result(#(Store, Order), CheckoutError) {
+  use existing <- result.try(get_order(db, order_id))
+  use refunded <- result.try(
+    order.transition(existing, order.Refund, clock())
+    |> result.map_error(Rejected),
+  )
+  use db <- result.try(
+    list.try_fold(existing.lines, db, fn(db, line) {
+      use product <- result.map(get_product(db, line.sku))
+      store.put_product(
+        db,
+        Product(..product, stock: product.stock + line.quantity),
+      )
+    }),
+  )
+  Ok(#(store.put_order(db, refunded), refunded))
+}
