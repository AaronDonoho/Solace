+pub fn orders_for_test() {
+  let db =
+    setup()
+    |> store.put_customer(customer.Customer(2, "Bob", customer.Domestic))
+  let assert Ok(#(db, first)) = checkout.create_order(db, clock.fixed(now), 1)
+  let assert Ok(#(db, _other_customer)) =
+    checkout.create_order(db, clock.fixed(now), 2)
+  let assert Ok(#(db, second)) =
+    checkout.create_order(db, clock.fixed(now + 1), 1)
+  let assert Ok(#(db, tied)) = checkout.create_order(db, clock.fixed(now + 1), 1)
+
+  let assert Ok(orders) = checkout.orders_for(db, 1)
+  assert orders == [tied, second, first]
+}
