+/// Returns a customer's orders, newest first by creation time, ties broken
+/// by order id (highest first).
+pub fn orders_for(
+  db: Store,
+  customer_id: Int,
+) -> Result(List(Order), CheckoutError) {
+  use _ <- result.try(
+    store.get_customer(db, customer_id)
+    |> result.replace_error(UnknownCustomer(customer_id)),
+  )
+  db.orders
+  |> dict.values
+  |> list.filter(fn(o) { o.customer_id == customer_id })
+  |> list.sort(by: fn(a, b) {
+    ordering.break_tie(
+      in: int.compare(b.created_at, a.created_at),
+      with: int.compare(b.id, a.id),
+    )
+  })
+  |> Ok
+}
