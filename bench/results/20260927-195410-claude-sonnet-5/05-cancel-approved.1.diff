+/// Cancels a draft, submitted, or approved order. If the order was approved,
+/// its reserved stock is returned to inventory.
 pub fn cancel(
   db: Store,
   clock: Clock,
   order_id: Int,
   reason: String,
 ) -> Result(#(Store, Order), CheckoutError) {
-  apply(db, clock, order_id, order.Cancel(reason))
+  use existing <- result.try(get_order(db, order_id))
+  use cancelled <- result.try(
+    order.transition(existing, order.Cancel(reason), clock())
+    |> result.map_error(Rejected),
+  )
+  use db <- result.try(case existing.status {
+    order.Approved ->
+      list.try_fold(existing.lines, db, fn(db, line) {
+        use product <- result.map(get_product(db, line.sku))
+        store.put_product(
+          db,
+          Product(..product, stock: product.stock + line.quantity),
+        )
+      })
+    _ -> Ok(db)
+  })
+  Ok(#(store.put_order(db, cancelled), cancelled))
 }
 
