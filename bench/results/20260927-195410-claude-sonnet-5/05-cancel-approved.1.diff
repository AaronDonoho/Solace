+
+pub fn cancelling_approved_order_returns_stock_test() {
+  let c = clock.fixed(now)
+  let assert Ok(#(db, o)) = checkout.create_order(setup(), c, 1)
+  let assert Ok(#(db, _)) = checkout.add_line(db, c, o.id, "A", 2)
+  let assert Ok(#(db, _)) = checkout.submit(db, c, o.id)
+  let assert Ok(#(db, _)) = checkout.approve(db, c, o.id)
+  let assert Ok(a) = store.get_product(db, "A")
+  assert a.stock == 3
+  let assert Ok(#(db, cancelled)) = checkout.cancel(db, c, o.id, "changed mind")
+  assert cancelled.status == order.Cancelled("changed mind")
+  let assert Ok(a) = store.get_product(db, "A")
+  assert a.stock == 5
+}
+
+pub fn cancelling_draft_or_submitted_order_does_not_change_stock_test() {
+  let c = clock.fixed(now)
+  let assert Ok(#(db, o)) = checkout.create_order(setup(), c, 1)
+  let assert Ok(#(db, _)) = checkout.add_line(db, c, o.id, "A", 2)
+  let assert Ok(#(db, cancelled)) = checkout.cancel(db, c, o.id, "draft cancel")
+  assert cancelled.status == order.Cancelled("draft cancel")
+  let assert Ok(a) = store.get_product(db, "A")
+  assert a.stock == 5
+
+  let assert Ok(#(db, o)) = checkout.create_order(setup(), c, 1)
+  let assert Ok(#(db, _)) = checkout.add_line(db, c, o.id, "A", 2)
+  let assert Ok(#(db, _)) = checkout.submit(db, c, o.id)
+  let assert Ok(#(db, cancelled)) =
+    checkout.cancel(db, c, o.id, "submitted cancel")
+  assert cancelled.status == order.Cancelled("submitted cancel")
+  let assert Ok(a) = store.get_product(db, "A")
+  assert a.stock == 5
+}
+
+pub fn cancelling_shipped_order_fails_test() {
+  let c = clock.fixed(now)
+  let assert Ok(#(db, o)) = checkout.create_order(setup(), c, 1)
+  let assert Ok(#(db, _)) = checkout.add_line(db, c, o.id, "A", 1)
+  let assert Ok(#(db, _)) = checkout.submit(db, c, o.id)
+  let assert Ok(#(db, _)) = checkout.approve(db, c, o.id)
+  let assert Ok(#(db, _)) = checkout.ship(db, c, o.id)
+  assert checkout.cancel(db, c, o.id, "too late")
+    == Error(Rejected(order.InvalidTransition(
+      from: order.Shipped,
+      action: order.Cancel("too late"),
+    )))
+}
