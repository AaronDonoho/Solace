+pub fn remove_line_test() {
+  let c = clock.fixed(now)
+  let assert Ok(#(db, o)) = checkout.create_order(setup(), c, 1)
+  let assert Ok(#(db, _)) = checkout.add_line(db, c, o.id, "A", 2)
+  let assert Ok(#(db, _)) = checkout.add_line(db, c, o.id, "B", 1)
+  let assert Ok(#(db, o)) = checkout.remove_line(db, c, o.id, "A")
+  assert o.lines == [Line("B", 1)]
+  assert o.updated_at == now
+
+  assert checkout.remove_line(db, c, o.id, "A") == Error(LineNotFound("A"))
+  assert checkout.remove_line(db, c, 99, "B") == Error(UnknownOrder(99))
+
+  let assert Ok(#(db, _)) = checkout.submit(db, c, o.id)
+  assert checkout.remove_line(db, c, o.id, "B")
+    == Error(OrderNotEditable(Submitted))
+}
