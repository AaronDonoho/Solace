diff --git a/test/pilot/checkout_test.gleam b/test/pilot/checkout_test.gleam
index a9a0fa4..f37bdac 100644
--- a/test/pilot/checkout_test.gleam
+++ b/test/pilot/checkout_test.gleam
@@ -174,3 +174,20 @@ pub fn origin_warehouse_test() {
   assert checkout.origin_warehouse([], customer.Domestic("CA"))
     == Error(checkout.NoWarehouse)
 }
+
+pub fn international_pay_uses_only_exporting_stock_test() {
+  let #(db, o) =
+    support.draft(seed.demo_store(), seed.linus, [#("TEE-M-BLK", 2)])
+  let c = support.on_day(0)
+  let assert Ok(#(db, _)) = checkout.submit(db, c, o.id)
+  let assert Ok(#(db, _)) =
+    checkout.pay(db, c, payments.fake_gateway(), o.id, "tok_ok", Standard)
+  assert store.allocations_for(db, o.id)
+    == [inventory.Allocation("WH-EAST", "TEE-M-BLK", 2)]
+
+  let #(db, o) =
+    support.draft(seed.demo_store(), seed.linus, [#("LAMP-OAK", 5)])
+  let assert Ok(#(db, _)) = checkout.submit(db, c, o.id)
+  assert checkout.pay(db, c, payments.fake_gateway(), o.id, "tok_ok", Standard)
+    == Error(checkout.Inventory(inventory.InsufficientStock("LAMP-OAK", 5, 4)))
+}
diff --git a/test/pilot/fulfillment_test.gleam b/test/pilot/fulfillment_test.gleam
index d631238..636fa17 100644
--- a/test/pilot/fulfillment_test.gleam
+++ b/test/pilot/fulfillment_test.gleam
@@ -120,3 +120,40 @@ pub fn must_be_paid_to_pick_test() {
   let assert Error(fulfillment.OrderRejected(_)) =
     fulfillment.start_picking(db, support.on_day(1), o.id, Standard)
 }
+
+pub fn international_shortage_cannot_use_non_exporting_replacement_test() {
+  let #(db, o) = support.paid(seed.demo_store(), seed.linus, [#("LAMP-OAK", 4)])
+  assert fulfillment.report_shortage(
+      db,
+      support.on_day(1),
+      o.id,
+      "WH-EAST",
+      "LAMP-OAK",
+      1,
+    )
+    == Error(
+      fulfillment.InventoryFailed(inventory.InsufficientStock("LAMP-OAK", 1, 0)),
+    )
+}
+
+pub fn international_consolidation_skips_non_exporting_warehouse_test() {
+  let #(db, o) =
+    support.paid(seed.demo_store(), seed.linus, [#("TEE-M-BLK", 2)])
+  let released = inventory.release(db.stock, store.allocations_for(db, o.id))
+  let assert Ok(stock) =
+    inventory.write_off(released, "WH-EAST", "TEE-M-BLK", 19)
+  let assert Ok(#(stock, east)) =
+    inventory.reserve_at(stock, "WH-EAST", "TEE-M-BLK", 1)
+  let assert Ok(#(stock, west)) =
+    inventory.reserve_at(stock, "WH-WEST", "TEE-M-BLK", 1)
+  let db =
+    db
+    |> store.set_stock(stock)
+    |> store.set_allocations(o.id, [east, west])
+  assert fulfillment.start_picking(db, support.on_day(1), o.id, Standard)
+    == Error(
+      fulfillment.ShipmentFailed(
+        shipments.MultipleWarehouses(["WH-EAST", "WH-WEST"]),
+      ),
+    )
+}
