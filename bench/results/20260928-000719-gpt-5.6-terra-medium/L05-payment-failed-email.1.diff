+fn record_payment_failure(
+  db: Store,
+  order_id: Int,
+  payment_error: PaymentError,
+  now: Int,
+) -> Store {
+  case payment_error, store.get_order(db, order_id) {
+    PaymentDeclined(_, attempts), Ok(order)
+    | GatewayUnavailable(attempts), Ok(order)
+    ->
+      case get_customer(db, order.customer_id) {
+        Ok(customer) ->
+          db
+          |> store.send(notifications.payment_failed(
+            customer,
+            order,
+            attempts,
+            now,
+          ))
+          |> store.record(
+            now,
+            actor,
+            "payment failed",
+            audit.order_subject(order_id),
+            "",
+          )
+        Error(_) -> db
+      }
+    _, _ -> db
+  }
 }
 
