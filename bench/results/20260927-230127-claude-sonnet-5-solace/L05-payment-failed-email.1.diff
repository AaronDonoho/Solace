+
+pub fn payment_failed(
+  customer: Customer,
+  order_id: Int,
+  attempts: Int,
+  now: Int,
+) -> Message {
+  Message(
+    to: customer.email,
+    subject: "We couldn't process payment for your " <> order_ref(order_id),
+    body: greeting(customer)
+      <> "We were unable to charge your card for this order.\n"
+      <> "Attempts: "
+      <> int.to_string(attempts)
+      <> "\n",
+    kind: PaymentFailed,
+    order_id:,
+    created_at: now,
+  )
+}
