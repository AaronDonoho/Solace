@@ -342,3 +368,74 @@ fn get_order(db: Store, id: Int) -> Result(Order, FulfillmentError) {
 fn get_shipment(db: Store, id: Int) -> Result(Shipment, FulfillmentError) {
   store.get_shipment(db, id) |> result.replace_error(UnknownShipment(id))
 }
+
+/// Builds the shipment(s) for an order's allocations: one shipment when they
+/// fit in a single warehouse (consolidating first if needed), otherwise one
+/// per warehouse. Shipment ids are fresh and consecutive.
+fn build_shipments(
+  db: Store,
+  order_id: Int,
+  allocations: List(Allocation),
+  method: Method,
+) -> Result(#(Store, List(Shipment)), FulfillmentError) {
+  case shipments.from_allocations(0, order_id, allocations, method) {
+    Error(shipments.MultipleWarehouses(_)) ->
+      case consolidate(db, order_id, allocations) {
+        Ok(#(db, consolidated)) ->
+          single_shipment(db, order_id, consolidated, method)
+        Error(_) -> {
+          let count =
+            allocations
+            |> list.map(fn(a) { a.warehouse_id })
+            |> list.unique
+            |> list.length
+          let #(db, first_id) = reserve_ids(db, count)
+          Ok(#(
+            db,
+            shipments.split_by_warehouse(
+              first_id,
+              order_id,
+              allocations,
+              method,
+            ),
+          ))
+        }
+      }
+    _ -> single_shipment(db, order_id, allocations, method)
+  }
+}
+
+fn single_shipment(
+  db: Store,
+  order_id: Int,
+  allocations: List(Allocation),
+  method: Method,
+) -> Result(#(Store, List(Shipment)), FulfillmentError) {
+  let #(db, id) = store.next_id(db)
+  use shipment <- result.try(
+    shipments.from_allocations(id, order_id, allocations, method)
+    |> result.map_error(ShipmentFailed),
+  )
+  Ok(#(db, [shipment]))
+}
+
+/// Reserves `count` fresh, consecutive ids, returning the first.
+fn reserve_ids(db: Store, count: Int) -> #(Store, Int) {
+  let #(db, first) = store.next_id(db)
+  #(reserve_more(db, count - 1), first)
+}
+
+fn reserve_more(db: Store, remaining: Int) -> Store {
+  case remaining <= 0 {
+    True -> db
+    False -> reserve_more(store.next_id(db).0, remaining - 1)
+  }
+}
+
+/// Removes `taken` from `allocations`, matching by warehouse and SKU.
+fn remove_allocations(
+  allocations: List(Allocation),
+  taken: List(Allocation),
+) -> List(Allocation) {
+  list.fold(taken, allocations, subtract)
+}
