index 69ae861..89fe00d 100644
--- a/src/pilot/reporting.gleam
+++ b/src/pilot/reporting.gleam
@@ -203,3 +203,49 @@ pub fn sales_summary(db: Store, from: Date, to: Date) -> String {
   <> money.format(sum(fn(d) { d.net_cents }))
   <> "\n"
 }
+
+pub type MonthlyRefunds {
+  MonthlyRefunds(
+    month: String,
+    reason: String,
+    returns: Int,
+    refunded_cents: Int,
+  )
+}
+
+/// Refunded returns grouped by the month they were refunded and reason,
+/// sorted by month then reason.
+pub fn refunds_by_month(db: Store) -> List(MonthlyRefunds) {
+  db.returns
+  |> dict.values
+  |> list.filter_map(fn(r) {
+    case r.status == return_policy.Refunded, r.refunded_at {
+      True, Some(refunded_at) -> Ok(#(r, refunded_at))
+      _, _ -> Error(Nil)
+    }
+  })
+  |> list.group(fn(pair) {
+    #(
+      string.slice(date.to_iso(date.from_unix_ms(pair.1)), 0, 7),
+      return_policy.reason_name({ pair.0 }.reason),
+    )
+  })
+  |> dict.to_list
+  |> list.map(fn(entry) {
+    let #(#(month, reason), rows) = entry
+    MonthlyRefunds(
+      month: month,
+      reason: reason,
+      returns: list.length(rows),
+      refunded_cents: money.sum(
+        list.map(rows, fn(pair) { { pair.0 }.refund.total_cents }),
+      ),
+    )
+  })
+  |> list.sort(fn(a, b) {
+    case string.compare(a.month, b.month) {
+      ordering.Eq -> string.compare(a.reason, b.reason)
+      other -> other
+    }
+  })
+}
