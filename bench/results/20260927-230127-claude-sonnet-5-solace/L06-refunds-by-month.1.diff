+
+pub fn refunds_by_month_test() {
+  let #(db, o, _) =
+    support.delivered(
+      seed.demo_store(),
+      seed.ada,
+      [#("TEE-M-BLK", 2), #("MUG-BLUE", 1)],
+      3,
+    )
+  let c = support.on_day(5)
+  let assert Ok(#(db, r1)) =
+    returns.request(db, c, o.id, [Item("TEE-M-BLK", 1)], NoLongerNeeded)
+  let assert Ok(#(db, _)) = returns.approve(db, c, r1.id)
+  let assert Ok(#(db, _)) = returns.receive(db, c, r1.id)
+  let assert Ok(#(db, _)) =
+    returns.refund(db, support.on_day(6), payments.fake_gateway(), r1.id)
+
+  let assert Ok(#(db, r2)) =
+    returns.request(db, c, o.id, [Item("MUG-BLUE", 1)], Damaged)
+  let assert Ok(#(db, _)) = returns.approve(db, c, r2.id)
+  let assert Ok(#(db, _)) = returns.receive(db, c, r2.id)
+  let assert Ok(#(db, _)) =
+    returns.refund(db, support.on_day(35), payments.fake_gateway(), r2.id)
+
+  assert reporting.refunds_by_month(db)
+    == [
+      MonthlyRefunds("2026-03", "no longer needed", 1, 1880),
+      MonthlyRefunds("2026-04", "damaged", 1, 1462),
+    ]
+}
