+pub fn fixed_coupon_after_loyalty_test() {
+  // Loyalty comes off the full subtotal before a fixed-amount coupon:
+  // 7400 - 5% (370) = 7030, then $10.00 off -> 6030.
+  let q =
+    pricing.quote(
+      [Line("L", 1, 7400)],
+      Gold,
+      Some(coupon(FixedOff(1000), True)),
+      ship(600),
+      Domestic("CA"),
+    )
+  assert q.loyalty_discount_cents == 370
+  assert q.coupon_discount_cents == 1000
+  assert pricing.goods_cents(q) == 6030
+  assert q.total_cents == 6030 + 600 + 437
+}
