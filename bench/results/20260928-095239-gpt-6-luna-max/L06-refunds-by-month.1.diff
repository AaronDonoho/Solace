+/// Refunded returns grouped by refund month and reason.
+pub fn refunds_by_month(db: Store) -> List(MonthlyRefunds) {
+  db.returns
+  |> dict.values
+  |> list.filter_map(fn(r) {
+    case r.status, r.refunded_at {
+      return_policy.Refunded, Some(refunded_at) -> {
+        let refunded_date = date.from_unix_ms(refunded_at)
+        let month =
+          int.to_string(refunded_date.year)
+          <> "-"
+          <> string.pad_start(int.to_string(refunded_date.month), 2, "0")
+        Ok(#(month, return_policy.reason_name(r.reason), r.refund.total_cents))
+      }
+      _, _ -> Error(Nil)
+    }
+  })
+  |> list.group(fn(refund) { #(refund.0, refund.1) })
+  |> dict.to_list
+  |> list.map(fn(pair) {
+    MonthlyRefunds(
+      month: pair.0.0,
+      reason: pair.0.1,
+      returns: list.length(pair.1),
+      refunded_cents: money.sum(list.map(pair.1, fn(refund) { refund.2 })),
+    )
+  })
+  |> list.sort(fn(a, b) {
+    case string.compare(a.month, b.month) {
+      ordering.Eq -> string.compare(a.reason, b.reason)
+      other -> other
+    }
+  })
+}
