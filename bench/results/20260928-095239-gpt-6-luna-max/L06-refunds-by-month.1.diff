+pub fn refunds_by_month_test() {
+  let db = seed.demo_store()
+  let #(db, march_damaged_one) = refund_one(db, "MUG-BLUE", Damaged, 5)
+  let #(db, march_damaged_two) = refund_one(db, "TEE-M-BLK", Damaged, 6)
+  let #(db, march_no_longer_needed) =
+    refund_one(db, "LAMP-OAK", NoLongerNeeded, 7)
+  let #(db, march_wrong_item) = refund_one(db, "CHARGER-65W", WrongItem, 8)
+  let #(db, april_damaged) = refund_one(db, "PHONES-BLK", Damaged, 30)
+  let #(db, order, _) = support.delivered(db, seed.ada, [#("MUG-BLUE", 1)], 3)
+  let assert Ok(#(db, _)) =
+    returns.request(
+      db,
+      support.on_day(5),
+      order.id,
+      [Item("MUG-BLUE", 1)],
+      Damaged,
+    )
+  assert reporting.refunds_by_month(db)
+    == [
+      MonthlyRefunds(
+        "2026-03",
+        "damaged",
+        2,
+        march_damaged_one + march_damaged_two,
+      ),
+      MonthlyRefunds("2026-03", "no longer needed", 1, march_no_longer_needed),
+      MonthlyRefunds("2026-03", "wrong item", 1, march_wrong_item),
+      MonthlyRefunds("2026-04", "damaged", 1, april_damaged),
+    ]
+}
+
+fn refund_one(
+  db: store.Store,
+  sku: String,
+  reason: return_policy.Reason,
+  refund_day: Int,
+) -> #(store.Store, Int) {
+  let #(db, order, _) = support.delivered(db, seed.ada, [#(sku, 1)], 3)
+  let assert Ok(#(db, request)) =
+    returns.request(db, support.on_day(5), order.id, [Item(sku, 1)], reason)
+  let assert Ok(#(db, _)) = returns.approve(db, support.on_day(5), request.id)
+  let assert Ok(#(db, _)) = returns.receive(db, support.on_day(5), request.id)
+  let assert Ok(#(db, refunded)) =
+    returns.refund(
+      db,
+      support.on_day(refund_day),
+      payments.fake_gateway(),
+      request.id,
+    )
+  #(db, refunded.refund.total_cents)
+}
