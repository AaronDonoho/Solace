+/// Consolidates a multi-warehouse reservation when possible. Otherwise the
+/// caller creates one shipment for each warehouse.
+fn resolve_allocations(
+  db: Store,
+  order_id: Int,
+  allocations: List(Allocation),
+  method: Method,
+) -> Result(#(Store, List(Allocation), Bool), FulfillmentError) {
+  case shipments.from_allocations(0, order_id, allocations, method) {
+    Ok(_) -> Ok(#(db, allocations, False))
+    Error(shipments.NothingToShip) ->
+      Error(ShipmentFailed(shipments.NothingToShip))
+    Error(shipments.MultipleWarehouses(_)) ->
+      case consolidate(db, order_id, allocations) {
+        Ok(#(db, consolidated)) -> Ok(#(db, consolidated, False))
+        Error(ShipmentFailed(shipments.MultipleWarehouses(_))) ->
+          Ok(#(db, allocations, True))
+        Error(error) -> Error(error)
+      }
+    Error(error) -> Error(ShipmentFailed(error))
+  }
+}
+
+/// Reserves consecutive ids from the shared store id sequence.
+fn allocate_ids(db: Store, count: Int) -> #(Store, List(Int)) {
+  case count {
+    0 -> #(db, [])
+    _ -> {
+      let #(db, id) = store.next_id(db)
+      let #(db, rest) = allocate_ids(db, count - 1)
+      #(db, [id, ..rest])
+    }
+  }
 }
 
