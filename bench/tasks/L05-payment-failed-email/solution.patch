+) -> #(Store, Result(Order, CheckoutError)) {
+  case attempt_payment(db, clock, gateway, order_id, card_token, method) {
+    Ok(#(db, paid)) -> #(db, Ok(paid))
+    Error(Payment(payments.PaymentDeclined(reason, attempts)) as e) -> #(
+      payment_failed(db, clock, order_id, reason, attempts),
+      Error(e),
+    )
+    Error(Payment(payments.GatewayUnavailable(attempts)) as e) -> #(
+      payment_failed(
+        db,
+        clock,
+        order_id,
+        "payment provider unavailable",
+        attempts,
+      ),
+      Error(e),
+    )
+    Error(e) -> #(db, Error(e))
+  }
+}
+
+fn payment_failed(
+  db: Store,
+  clock: Clock,
+  order_id: Int,
+  reason: String,
+  attempts: Int,
+) -> Store {
+  let now = clock()
+  let db =
+    store.record(
+      db,
+      now,
+      actor,
+      "payment failed",
+      audit.order_subject(order_id),
+      reason,
+    )
+  case store.get_order(db, order_id) {
+    Ok(existing) ->
+      case store.get_customer(db, existing.customer_id) {
+        Ok(customer) ->
+          store.send(
+            db,
+            notifications.payment_failed(
+              customer,
+              order_id,
+              reason,
+              attempts,
+              now,
+            ),
+          )
+        Error(Nil) -> db
+      }
+    Error(Nil) -> db
+  }
+}
+
+fn attempt_payment(
