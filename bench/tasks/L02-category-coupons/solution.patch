+/// Value of the lines a coupon applies to: all of them, or only those in its
+/// category.
+pub fn eligible_cents(
+  coupon: Coupon,
+  lines: List(Line),
+  categories: Dict(String, Category),
+) -> Int {
+  case coupon.category {
+    None -> order.subtotal_cents(lines)
+    Some(category) ->
+      lines
+      |> list.filter(fn(l) { dict.get(categories, l.sku) == Ok(category) })
+      |> order.subtotal_cents
+  }
+}
