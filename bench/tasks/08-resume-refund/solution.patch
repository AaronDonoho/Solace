+/// Refunds a shipped order, returning its stock to inventory.
+pub fn refund(
+  db: Store,
+  clock: Clock,
+  order_id: Int,
+) -> Result(#(Store, Order), CheckoutError) {
+  use existing <- result.try(get_order(db, order_id))
+  use #(db, refunded) <- result.try(apply(db, clock, order_id, order.Refund))
+  use db <- result.try(restock(db, existing))
+  Ok(#(db, refunded))
+}
