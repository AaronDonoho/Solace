+/// Removes the line for a product from a draft order.
+pub fn remove_line(
+  db: Store,
+  clock: Clock,
+  order_id: Int,
+  sku: String,
+) -> Result(#(Store, Order), CheckoutError) {
+  use existing <- result.try(get_order(db, order_id))
+  use <- bool.guard(
+    !order.is_editable(existing),
+    Error(OrderNotEditable(existing.status)),
+  )
+  use <- bool.guard(
+    !list.any(existing.lines, fn(l) { l.sku == sku }),
+    Error(LineNotFound(sku)),
+  )
+  let lines = list.filter(existing.lines, fn(l) { l.sku != sku })
+  let updated = order.Order(..existing, lines:, updated_at: clock())
+  Ok(#(store.put_order(db, updated), updated))
+}
