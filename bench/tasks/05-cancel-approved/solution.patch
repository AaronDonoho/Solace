diff --git a/src/pilot/checkout.gleam b/src/pilot/checkout.gleam
index 98e1630..ef4038f 100644
--- a/src/pilot/checkout.gleam
+++ b/src/pilot/checkout.gleam
@@ -106,13 +106,25 @@ pub fn ship(
   apply(db, clock, order_id, order.Ship)
 }
 
+/// Cancels an order. Cancelling an approved order returns its reserved stock.
 pub fn cancel(
   db: Store,
   clock: Clock,
   order_id: Int,
   reason: String,
 ) -> Result(#(Store, Order), CheckoutError) {
-  apply(db, clock, order_id, order.Cancel(reason))
+  use existing <- result.try(get_order(db, order_id))
+  use #(db, cancelled) <- result.try(apply(
+    db,
+    clock,
+    order_id,
+    order.Cancel(reason),
+  ))
+  use db <- result.try(case existing.status {
+    order.Approved -> restock(db, existing)
+    _ -> Ok(db)
+  })
+  Ok(#(db, cancelled))
 }
 
 pub fn quote(db: Store, order_id: Int) -> Result(Quote, CheckoutError) {
@@ -151,3 +163,13 @@ fn get_order(db: Store, id: Int) -> Result(Order, CheckoutError) {
 fn get_product(db: Store, sku: String) -> Result(Product, CheckoutError) {
   store.get_product(db, sku) |> result.replace_error(UnknownProduct(sku))
 }
+
+fn restock(db: Store, existing: Order) -> Result(Store, CheckoutError) {
+  list.try_fold(existing.lines, db, fn(db, line) {
+    use product <- result.try(get_product(db, line.sku))
+    Ok(store.put_product(
+      db,
+      Product(..product, stock: product.stock + line.quantity),
+    ))
+  })
+}
