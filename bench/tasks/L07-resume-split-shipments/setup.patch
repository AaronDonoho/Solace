+/// One shipment per warehouse, for orders whose stock is reserved across
+/// several warehouses. Shipments get consecutive ids starting at `first_id`,
+/// in warehouse id order.
+pub fn split_by_warehouse(
+  first_id: Int,
+  order_id: Int,
+  allocations: List(Allocation),
+  method: Method,
+) -> List(Shipment) {
+  allocations
+  |> list.map(fn(a) { a.warehouse_id })
+  |> list.unique
+  |> list.sort(string.compare)
+  |> list.index_map(fn(warehouse_id, index) {
+    let assert Ok(shipment) =
+      from_allocations(
+        first_id + index,
+        order_id,
+        list.filter(allocations, fn(a) { a.warehouse_id == warehouse_id }),
+        method,
+      )
+    shipment
+  })
+}
