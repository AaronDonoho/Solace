+/// A customer's orders, newest first (ties broken by id, highest first).
+pub fn orders_for(
+  db: Store,
+  customer_id: Int,
+) -> Result(List(Order), CheckoutError) {
+  use _ <- result.try(
+    store.get_customer(db, customer_id)
+    |> result.replace_error(UnknownCustomer(customer_id)),
+  )
+  dict.values(db.orders)
+  |> list.filter(fn(o) { o.customer_id == customer_id })
+  |> list.sort(fn(a, b) {
+    case int.compare(b.created_at, a.created_at) {
+      ordering.Eq -> int.compare(b.id, a.id)
+      other -> other
+    }
+  })
+  |> Ok
+}
