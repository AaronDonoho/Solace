+/// Refunded returns per month of refund (`"2026-03"`) and reason, sorted by
+/// month and then reason.
+pub fn refunds_by_month(db: Store) -> List(MonthlyRefunds) {
+  db.returns
+  |> dict.values
+  |> list.filter_map(fn(r) {
+    case r.status, r.refunded_at {
+      return_policy.Refunded, Some(at) -> {
+        let d = date.from_unix_ms(at)
+        let month = string.slice(date.to_iso(d), 0, 7)
+        Ok(#(#(month, return_policy.reason_name(r.reason)), r))
+      }
+      _, _ -> Error(Nil)
+    }
+  })
+  |> list.group(fn(pair) { pair.0 })
+  |> dict.to_list
+  |> list.map(fn(group) {
+    let #(#(month, reason), rows) = group
+    MonthlyRefunds(
+      month:,
+      reason:,
+      returns: list.length(rows),
+      refunded_cents: money.sum(
+        list.map(rows, fn(p) { { p.1 }.refund.total_cents }),
+      ),
+    )
+  })
+  |> list.sort(fn(a, b) {
+    string.compare(a.month <> a.reason, b.month <> b.reason)
+  })
+}
