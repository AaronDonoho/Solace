{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "board-release-folder",
  "description": "Board windows may open one release's folder from the Build tab, and nothing else.",
  "windows": ["board-*"],
  "remote": {
    "urls": ["http://127.0.0.1:*", "http://localhost:*"]
  },
  "permissions": ["allow-open-release-folder"]
}
